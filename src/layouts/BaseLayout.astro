---
import '../styles/global.css';
import PwaOfflineIndicator from '../components/PwaOfflineIndicator.astro';

const DEFAULT_DESCRIPTION =
  'Ops Handbook — a structured DevOps knowledge base: documentation, labs, diagrams, and command references.';

interface Props {
  title: string;
  description?: string;
  /** Keep the page out of search results (404, internal demo pages). */
  noindex?: boolean;
  /** Open Graph page type — documentation articles pass `article`. */
  ogType?: 'website' | 'article';
  /** Content language, used in structured data. */
  lang?: string;
  /** Suppress default footer when page defines its own footer landmark */
  hideFooter?: boolean;
}

const {
  title,
  description: rawDescription,
  noindex = false,
  ogType = 'website',
  lang = 'en',
  hideFooter = false,
} = Astro.props;

if (!Astro.site) {
  throw new Error('[seo] astro.config.mjs must set `site` for canonical/OG URLs.');
}

const description = rawDescription?.trim() ? rawDescription : DEFAULT_DESCRIPTION;
const siteName = 'Ops Handbook';

// Canonical URL: production origin + route, normalized to a single
// trailing-slash variant (trailingSlash: 'ignore' → no trailing slash,
// except the site root).
const pathname = Astro.url.pathname.replace(/\/+$/, '') || '/';
const canonical = new URL(pathname, Astro.site).href;
const ogImage = new URL('/og/ops-handbook.png', Astro.site).href;
const ogImageAlt = 'Ops Handbook — DevOps Knowledge Base';

// Restrained structured data: the site plus the current page (WebPage, or
// TechArticle on documentation articles). Real data only — no authors,
// dates, or ratings are invented.
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', name: siteName, url: Astro.site.href },
    ogType === 'article'
      ? {
          '@type': 'TechArticle',
          headline: title.replace(/ \| Ops Handbook$/, ''),
          description,
          url: canonical,
          inLanguage: lang,
          mainEntityOfPage: canonical,
        }
      : { '@type': 'WebPage', name: title, description, url: canonical },
  ],
};
---

<!doctype html>
<html lang="en" dir="ltr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />

    <!-- Web App Manifest & Mobile Web App -->
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content={siteName} />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <meta name="theme-color" content="#e9dfce" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b0e13" media="(prefers-color-scheme: dark)" />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <!-- Twitter / X -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
    <!-- Theme-aware favicon: the exact header logo mark, light/dark variants. -->
    <link
      rel="icon"
      type="image/svg+xml"
      href="/logo/mark-light.svg"
      media="(prefers-color-scheme: light)"
    />
    <link
      rel="icon"
      type="image/svg+xml"
      href="/logo/mark-dark.svg"
      media="(prefers-color-scheme: dark)"
    />
    <!-- RSS feed -->
    <link rel="alternate" type="application/rss+xml" title="Ops Handbook" href="/rss.xml" />
    <!-- Applies the stored theme (light / dark / system) before first paint. -->
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('theme');
          var mode =
            stored === 'light' || stored === 'dark' || stored === 'system'
              ? stored
              : 'system';
          var dark =
            mode === 'dark' ||
            (mode === 'system' &&
              window.matchMedia('(prefers-color-scheme: dark)').matches);
          document.documentElement.classList.toggle('dark', dark);

          var themeColor = dark ? '#0b0e13' : '#e9dfce';
          var metas = document.querySelectorAll('meta[name="theme-color"]');
          for (var i = 0; i < metas.length; i++) {
            metas[i].setAttribute('content', themeColor);
          }
        } catch (e) {
          /* storage unavailable — keep the light default */
        }
      })();
    </script>
  </head>
  <body class="min-h-screen">
    <a class="skip-link" href="#main">Skip to content</a>
    <slot />

    {!hideFooter && (
      <footer class="border-t border-border py-6 text-center text-xs text-muted" style="padding-bottom: calc(1.5rem + env(safe-area-inset-bottom, 0px));">
        <div class="mx-auto flex max-w-screen-2xl flex-wrap items-center justify-between gap-4 px-4">
          <p>Ops Handbook — Arabic-first DevOps knowledge base</p>
          <p class="flex items-center gap-3">
            <a href="/docs" class="transition-colors hover:text-accent-ink">Docs</a>
            <span aria-hidden="true">·</span>
            <a href="https://github.com/mustafammasoud/ops-handbook" target="_blank" rel="noopener noreferrer" class="transition-colors hover:text-accent-ink">GitHub</a>
          </p>
        </div>
      </footer>
    )}

    <PwaOfflineIndicator />

    <!-- Service Worker Registration -->
    <script is:inline>
      if ('serviceWorker' in navigator) {
        window.addEventListener('load', function () {
          navigator.serviceWorker
            .register('/sw.js', { scope: '/' })
            .catch(function (err) {
              console.warn('[PWA] Service Worker registration failed:', err);
            });
        });
      }
    </script>
  </body>
</html>
