---
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import DocEnhancements from '../components/DocEnhancements.astro';
import CategoryIcon from '../components/CategoryIcon.astro';
import type { Technology } from '../data/technologies';
import { categoryLabel } from '../data/categories';

interface Props {
  entry: CollectionEntry<'cheatSheets'>;
  technology: Technology;
  topics: CollectionEntry<'cheatSheets'>[];
}

const { entry, technology, topics } = Astro.props;
const { title, description, language = 'ar' } = entry.data;
const dir = language === 'ar' ? 'rtl' : 'ltr';

// Sorted topics
const sortedTopics = [...topics].sort((a, b) => a.data.order - b.data.order);
const currentIndex = sortedTopics.findIndex((t) => t.id === entry.id);
const prevTopic = currentIndex > 0 ? sortedTopics[currentIndex - 1] : null;
const nextTopic = currentIndex >= 0 && currentIndex < sortedTopics.length - 1 ? sortedTopics[currentIndex + 1] : null;

const pageTitle = `${title} — ${technology.name} Cheat Sheet | Ops Handbook`;
---

<BaseLayout title={pageTitle} description={description} ogType="article" lang={language}>
  <Header />

  <div class="mx-auto flex w-full max-w-screen-2xl gap-8 px-4 py-6 lg:py-10">
    <!-- Desktop Sidebar: Topics Rail -->
    <aside class="hidden w-72 shrink-0 lg:block">
      <div class="sticky top-20 flex max-h-[calc(100vh-6rem)] flex-col rounded-xl border border-border bg-surface p-4">
        <!-- Technology Header -->
        <div class="mb-4 border-b border-border pb-3">
          <div class="flex items-center gap-2.5">
            <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-lg bg-surface-2 text-accent-ink border border-border">
              <CategoryIcon name={technology.icon} class="h-5 w-5" />
            </div>
            <div class="min-w-0">
              <a
                href={`/cheat-sheets/${technology.id}`}
                class="block truncate font-semibold text-text hover:text-accent-ink transition-colors"
              >
                {technology.name}
              </a>
              <span class="text-xs text-muted">Cheat Sheet Topics</span>
            </div>
          </div>
        </div>

        <!-- Topics List -->
        <nav aria-label={`${technology.name} Topics`} class="flex-1 overflow-y-auto space-y-1 pr-1">
          {sortedTopics.map((topicItem) => {
            const isActive = topicItem.id === entry.id;
            return (
              <a
                href={`/cheat-sheets/${technology.id}/${topicItem.data.topic}`}
                class:list={[
                  'group flex items-center justify-between rounded-lg px-3 py-2 text-sm transition-colors',
                  isActive
                    ? 'bg-accent/15 text-accent-ink font-semibold shadow-xs'
                    : 'text-muted hover:bg-surface-2 hover:text-text',
                ]}
                aria-current={isActive ? 'page' : undefined}
              >
                <span class="truncate">{topicItem.data.title}</span>
                <span
                  class:list={[
                    'text-xs font-mono ml-2 shrink-0',
                    isActive ? 'text-accent-ink' : 'text-muted/60 group-hover:text-muted',
                  ]}
                >
                  #{topicItem.data.order}
                </span>
              </a>
            );
          })}
        </nav>

        <!-- Back to Cheat Sheets Hub -->
        <div class="mt-4 border-t border-border pt-3">
          <a
            href="/cheat-sheets"
            class="flex items-center gap-1.5 text-xs font-medium text-muted hover:text-accent-ink transition-colors"
          >
            <span aria-hidden="true">&larr;</span>
            <span>All Cheat Sheets</span>
          </a>
        </div>
      </div>
    </aside>

    <!-- Main Content -->
    <main id="main" class="min-w-0 flex-1">
      <!-- Mobile Topics Accordion -->
      <details class="mb-6 rounded-xl border border-border bg-surface lg:hidden">
        <summary class="flex cursor-pointer items-center justify-between px-4 py-3 text-sm font-medium">
          <span class="flex items-center gap-2">
            <CategoryIcon name={technology.icon} class="h-4 w-4 text-accent-ink" />
            <span>{technology.name} Topics ({sortedTopics.length})</span>
          </span>
          <span class="text-xs text-muted">Tap to view</span>
        </summary>
        <div class="border-t border-border p-3 space-y-1">
          {sortedTopics.map((topicItem) => {
            const isActive = topicItem.id === entry.id;
            return (
              <a
                href={`/cheat-sheets/${technology.id}/${topicItem.data.topic}`}
                class:list={[
                  'flex items-center justify-between rounded-lg px-3 py-2 text-sm transition-colors',
                  isActive
                    ? 'bg-accent/15 text-accent-ink font-medium'
                    : 'text-muted hover:bg-surface-2 hover:text-text',
                ]}
                aria-current={isActive ? 'page' : undefined}
              >
                <span class="truncate">{topicItem.data.title}</span>
                <span class="text-xs font-mono text-muted/60">#{topicItem.data.order}</span>
              </a>
            );
          })}
          <div class="border-t border-border pt-2 mt-2">
            <a href="/cheat-sheets" class="block text-xs font-medium text-muted hover:text-accent-ink px-3 py-1">
              &larr; All Cheat Sheets
            </a>
          </div>
        </div>
      </details>

      <!-- Breadcrumbs -->
      <nav aria-label="Breadcrumb" class="mb-4 text-sm text-muted">
        <ol class="flex flex-wrap items-center gap-1.5">
          <li>
            <a href="/" class="hover:text-accent-ink transition-colors">Home</a>
          </li>
          <li aria-hidden="true">/</li>
          <li>
            <a href="/cheat-sheets" class="hover:text-accent-ink transition-colors">Cheat Sheets</a>
          </li>
          <li aria-hidden="true">/</li>
          <li>
            <a href={`/cheat-sheets/${technology.id}`} class="hover:text-accent-ink transition-colors">
              {technology.name}
            </a>
          </li>
          <li aria-hidden="true">/</li>
          <li aria-current="page" class="font-medium text-text truncate max-w-xs sm:max-w-md">
            {title}
          </li>
        </ol>
      </nav>

      <!-- Topic Header -->
      <header class="mb-8 border-b border-border pb-6">
        <div class="mb-2 flex items-center gap-2">
          <span class="inline-flex items-center gap-1 rounded-full border border-border bg-surface px-2.5 py-0.5 text-xs font-medium text-muted">
            <CategoryIcon name={technology.icon} class="h-3.5 w-3.5 text-accent-ink" />
            <span>{technology.name}</span>
          </span>
          <span class="text-xs text-muted">·</span>
          <span class="text-xs text-muted">{categoryLabel(technology.category)}</span>
          <span class="text-xs text-muted">·</span>
          <span class="text-xs font-mono text-muted">Topic {entry.data.order} of {sortedTopics.length}</span>
        </div>

        <h1 class="text-2xl font-bold leading-snug tracking-tight text-text sm:text-3xl">{title}</h1>
        {description && <p class="mt-3 text-muted leading-relaxed text-base">{description}</p>}
      </header>

      <!-- MDX Article Body -->
      <article class="prose max-w-4xl" dir={dir} lang={language}>
        <slot />
      </article>

      <!-- Topic Navigation Footer (Prev / Next) -->
      <nav class="mt-12 border-t border-border pt-6" aria-label="Topic navigation">
        <div class="grid grid-cols-1 gap-4 sm:grid-cols-2">
          {prevTopic ? (
            <a
              href={`/cheat-sheets/${technology.id}/${prevTopic.data.topic}`}
              class="flex flex-col rounded-xl border border-border bg-surface p-4 transition-colors hover:border-accent/40 hover:bg-surface-2"
            >
              <span class="text-xs font-medium text-muted flex items-center gap-1">
                <span aria-hidden="true">&larr;</span> Previous Topic
              </span>
              <span class="mt-1 text-sm font-semibold text-text">{prevTopic.data.title}</span>
            </a>
          ) : (
            <div />
          )}

          {nextTopic ? (
            <a
              href={`/cheat-sheets/${technology.id}/${nextTopic.data.topic}`}
              class="flex flex-col items-end text-right rounded-xl border border-border bg-surface p-4 transition-colors hover:border-accent/40 hover:bg-surface-2 sm:col-start-2"
            >
              <span class="text-xs font-medium text-muted flex items-center gap-1">
                Next Topic <span aria-hidden="true">&rarr;</span>
              </span>
              <span class="mt-1 text-sm font-semibold text-text">{nextTopic.data.title}</span>
            </a>
          ) : (
            <div />
          )}
        </div>
      </nav>
    </main>
  </div>

  <DocEnhancements />
</BaseLayout>
