---
import { getCollection } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import Header from '../components/Header.astro';
import Sidebar from '../components/Sidebar.astro';
import TableOfContents from '../components/TableOfContents.astro';
import DocEnhancements from '../components/DocEnhancements.astro';
import MermaidRuntime from '../components/MermaidRuntime.astro';
import ReadingProgress from '../components/ReadingProgress.astro';
import RelatedTopics from '../components/RelatedTopics.astro';
import PlannedState from '../components/PlannedState.astro';
import CategoryIcon from '../components/CategoryIcon.astro';
import ArticleActions from '../components/ArticleActions.astro';
import ArticleFeedback from '../components/ArticleFeedback.astro';
import { categoryLabel, getCategory, toolLabel, levelLabel } from '../data/categories';
import { docCategory, docPath, docTool, sortedDocs, hasPublishedContent } from '../utils/docs';
import { githubEditUrl, githubFeedbackIssueUrl } from '../utils/github';
import { readingMinutes, lastModified } from '../utils/metadata';
import type { CollectionEntry } from 'astro:content';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  entry: CollectionEntry<'docs'>;
  headings: Heading[];
}

const { entry, headings } = Astro.props;
const { title, description, level, tags, language } = entry.data;
const category = docCategory(entry);
const tool = docTool(entry);
const dir = language === 'ar' ? 'rtl' : 'ltr';

// Every article belongs to exactly one learning-path group: its tool when
// nested (`area/tool/article`), otherwise its area. The ordered article list
// is derived entirely from content metadata — no hardcoded URLs — and drafts
// are already excluded above. Prev/next and progress never cross groups.
const ordered = sortedDocs(
  await getCollection('docs', ({ data }) => !data.draft),
);
const groupTool = tool;
const groupDocs = ordered.filter(
  (doc) =>
    docCategory(doc) === category &&
    (groupTool ? docTool(doc) === groupTool : !docTool(doc)),
);
const stepIndex = groupDocs.findIndex((doc) => doc.id === entry.id);
const inGroup = stepIndex >= 0;
const step = inGroup ? stepIndex + 1 : 0;
const prevDoc = inGroup && stepIndex > 0 ? groupDocs[stepIndex - 1] : null;
const nextDoc =
  inGroup && stepIndex < groupDocs.length - 1 ? groupDocs[stepIndex + 1] : null;

// Learning-path display label and per-group progress scope. The group key
// is namespaced by area so identically named tools in different areas
// (hypothetically) stay independent.
const groupLabel = groupTool ? toolLabel(groupTool) : categoryLabel(category);
const groupKey = groupTool ? `${category}/${groupTool}` : category;
const progressKey = `ops-handbook:progress:${groupKey}`;
const pathRoutes = groupDocs.map((doc) => docPath(doc.id));

// Shared article metadata — computed centrally for every document that
// renders through this layout (no per-article configuration):
//   * reading time from the article's actual body,
//   * last-updated from Git/build file metadata (frontmatter `date` only
//     as a fallback, file mtime as last resort — see utils/metadata.ts).
const minutes = readingMinutes(entry.body);
const updatedAt = lastModified(entry.filePath, entry.data.date);
// A topic without real content (empty body or generic placeholder copy) is
// still planned: the shared layer renders the Planned / Coming Soon state
// instead of article content, metadata, and description — automatically,
// with no per-article configuration.
const hasContent = hasPublishedContent(entry);
const lastUpdated = updatedAt
  ? new Intl.DateTimeFormat('en-US', {
      month: 'short',
      day: 'numeric',
      year: 'numeric',
      timeZone: 'UTC',
    }).format(updatedAt)
  : null;

// Current area, reused by the collapsed sidebar rail for context.
const categoryMeta = getCategory(category);

const pageTitle = title === 'Ops Handbook' ? 'Ops Handbook' : `${title} | Ops Handbook`;

// Canonical URL for sharing / issue prefill.
const canonicalUrl = Astro.site
  ? new URL(docPath(entry.id), Astro.site).href
  : docPath(entry.id);
const editUrl = githubEditUrl(entry.filePath);
const issueUrl = githubFeedbackIssueUrl(title, canonicalUrl);
---

<BaseLayout title={pageTitle} description={description} ogType="article" lang={language}>
  <Header />
  <ReadingProgress />

  <!-- Restore sidebar state before first paint (no flicker). -->
  <script is:inline>
    (function () {
      try {
        var w = localStorage.getItem('atlas-sidebar-w');
        if (w) document.documentElement.style.setProperty('--docs-sidebar-w', w);
        if (localStorage.getItem('atlas-sidebar-collapsed') === '1')
          document.documentElement.classList.add('sb-collapsed');
      } catch (e) {
        /* storage unavailable — defaults apply */
      }
    })();
  </script>

  <div class="mx-auto flex w-full max-w-screen-2xl gap-6 px-4">
    <!-- Sidebar (desktop): collapsible + resizable -->
    <div class="docs-sidebar-wrap" data-sidebar-wrap>
      <aside class="docs-sidebar" id="docs-sidebar">
        <div class="docs-sidebar-inner">
          <Sidebar currentId={entry.id} />
        </div>
      </aside>

      <!-- Context while the sidebar is collapsed: current area icon and a
           compact "Docs" label. Decorative — no focusable children. -->
      <div
        class="docs-sidebar-rail"
        aria-hidden="true"
        title={categoryMeta?.label ?? categoryLabel(category)}
      >
        {
          categoryMeta && (
            <CategoryIcon name={categoryMeta.icon} class="h-5 w-5" />
          )
        }
        <span class="docs-sidebar-rail-label" lang="en">Docs</span>
      </div>

      <button
        type="button"
        class="docs-sidebar-toggle"
        data-sidebar-toggle
        aria-expanded="true"
        aria-controls="docs-sidebar"
        aria-label="Collapse sidebar"
        title="Collapse sidebar"
      >
        <svg
          class="docs-sidebar-icon h-5 w-5"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M15 6l-6 6 6 6"></path>
        </svg>
      </button>

      <div
        class="docs-sidebar-resize"
        data-sidebar-resize
        role="separator"
        aria-orientation="vertical"
        aria-label="Resize sidebar"
        tabindex="0"
        title="Drag to resize — double-click to reset"
      ></div>
    </div>

    <main id="main" class="min-w-0 flex-1 py-6 lg:py-10">
      <!-- Sidebar (mobile) -->
      <details class="mb-6 rounded-md border border-border bg-surface lg:hidden">
        <summary
          class="cursor-pointer px-4 py-2.5 text-sm font-medium"
        >
          Contents
        </summary>
        <div class="border-t border-border p-4">
          <Sidebar currentId={entry.id} />
        </div>
      </details>

      <!-- Breadcrumbs -->
      <nav
        aria-label="Breadcrumb"
        class="mb-4 text-sm text-muted"
      >
        <ol class="flex flex-wrap items-center gap-1.5">
          <li>
            <a href="/" class="hover:text-accent-ink">Home</a>
          </li>
          <li aria-hidden="true">/</li>
          <li>
            <a href="/docs" class="hover:text-accent-ink">Docs</a>
          </li>
          <li aria-hidden="true">/</li>
          <li>
            <a href={`/docs/${category}`} class="hover:text-accent-ink">
              {categoryLabel(category)}
            </a>
          </li>
          {
            tool && (
              <>
                <li aria-hidden="true">/</li>
                <li class="text-muted" lang="en">
                  {toolLabel(tool)}
                </li>
              </>
            )
          }
          <li aria-hidden="true">/</li>
          <li aria-current="page" class="font-medium text-text">{title}</li>
        </ol>
      </nav>

      <header class="mb-8 border-b border-border pb-6">
        <p class="mb-2 text-sm text-muted">
          <span lang="en">
            {categoryLabel(category)}
            {tool ? ` · ${toolLabel(tool)}` : ''}
          </span>
          <span aria-hidden="true"> · </span>
          <span>{levelLabel(level)}</span>
          {
            hasContent && (
              <>
                <span aria-hidden="true"> · </span>
                <span lang="en">{`${minutes} min read`}</span>
              </>
            )
          }
        </p>
        {
          hasContent && lastUpdated && updatedAt && (
            <p class="mb-2 text-sm text-muted" lang="en">
              Last updated ·{' '}
              <time datetime={updatedAt.toISOString()}>{lastUpdated}</time>
            </p>
          )
        }
        <h1 class="text-2xl font-semibold leading-snug tracking-tight sm:text-3xl">{title}</h1>
        {
          description && hasContent && (
            <p class="mt-3 max-w-3xl text-muted leading-relaxed">{description}</p>
          )
        }
        {
          tags.length > 0 && (
            <ul class="mt-4 flex flex-wrap gap-2">
              {tags.map((tag) => (
                <li
                  class="rounded-full border border-border bg-surface px-2.5 py-0.5 text-xs text-muted"
                  dir="ltr"
                >
                  {tag}
                </li>
              ))}
            </ul>
          )
        }
      </header>

      <ArticleActions editUrl={editUrl} shareUrl={canonicalUrl} shareTitle={title} />

      <!-- The document region owns its language and text direction. Planned
           topics (no published content) show the shared empty state instead. -->
      {
        hasContent ? (
          <article class="prose max-w-3xl" dir={dir} lang={language}>
            <slot />
          </article>
        ) : (
          <PlannedState name={title} />
        )
      }

      <ArticleFeedback issueUrl={issueUrl} />

      <!-- Marker observed to auto-complete an article when the reader
           actually reaches the end (never on load alone). -->
      {inGroup && <div data-fp-end aria-hidden="true" class="h-px"></div>}

      <!-- Prev / next. Every page gets the learning-path variant
           (step context + progress) integrated into this same navigation,
           scoped to the article's own group. -->
      <nav
        class="mt-12 max-w-3xl border-t border-border pt-6"
        aria-label={inGroup ? `${groupLabel} learning path` : 'Page navigation'}
      >
        {
          inGroup && (
            <div class="flex flex-wrap items-baseline justify-between gap-x-4 gap-y-2">
              <p class="eyebrow eyebrow-accent" lang="en">
                {`${groupLabel} · Step ${step} of ${groupDocs.length}`}
              </p>
              <div
                class="fp-controls text-sm"
                data-fp
                data-fp-current={docPath(entry.id)}
                data-fp-path={pathRoutes.join(',')}
                data-fp-store={progressKey}
                hidden
              >
                <span class="fp-count text-muted" data-fp-count aria-live="polite"></span>
                <a class="font-medium text-accent-ink hover:underline" data-fp-continue hidden>
                  Continue →
                </a>
                <span class="font-medium text-accent-ink" data-fp-done hidden></span>
                <button
                  type="button"
                  class="fp-toggle"
                  data-fp-toggle
                  aria-pressed="false"
                >
                  ✓ Mark as complete
                </button>
              </div>
            </div>
          )
        }
        {
          (prevDoc || nextDoc) && (
            <div class={`grid gap-4 sm:grid-cols-2${inGroup ? ' mt-4' : ''}`}>
              {prevDoc ? (
                <a
                  href={docPath(prevDoc.id)}
                  class="rounded-md border border-border p-4 transition-colors hover:border-accent/50 hover:bg-surface"
                >
                  <span class="text-xs text-muted">Previous</span>
                  <span class="mt-1 block font-medium">{prevDoc.data.title}</span>
                </a>
              ) : (
                <span />
              )}
              {nextDoc ? (
                <a
                  href={docPath(nextDoc.id)}
                  class="rounded-md border border-border p-4 text-end transition-colors hover:border-accent/50 hover:bg-surface sm:col-start-2"
                >
                  <span class="text-xs text-muted">Next</span>
                  <span class="mt-1 block font-medium">{nextDoc.data.title}</span>
                </a>
              ) : (
                <span />
              )}
            </div>
          )
        }
      </nav>

      <!-- Learning-path progress: localStorage only — no cookies, network,
           or personal data. Each group has its own storage key (passed via
           data-fp-store), so progress is scoped per group. Controls start
           hidden and are revealed after storage is read; if storage is
           unavailable they stay hidden. -->
      <script>
        // Pre-generalization key — read as a fallback so existing
        // Fundamentals progress carries over (only that group used it).
        const LEGACY_STORE_KEY = 'ops-handbook:fundamentals-progress';

        const controls = document.querySelector<HTMLElement>('[data-fp]');
        if (controls) {
          const STORE_KEY = controls.dataset.fpStore ?? LEGACY_STORE_KEY;
          const normalize = (route: string): string => route.replace(/\/+$/, '') || '/';

          const read = (): string[] | null => {
            try {
              const raw =
                localStorage.getItem(STORE_KEY) ?? localStorage.getItem(LEGACY_STORE_KEY);
              if (!raw) return [];
              const parsed: unknown = JSON.parse(raw);
              if (!Array.isArray(parsed)) return [];
              return parsed.filter((value): value is string => typeof value === 'string');
            } catch {
              return null; // storage unavailable or corrupt — degrade
            }
          };

          const stored = read();
          const current = normalize(controls.dataset.fpCurrent ?? '');
          const path = (controls.dataset.fpPath ?? '')
            .split(',')
            .filter(Boolean)
            .map(normalize);

          if (stored !== null && path.includes(current)) {
            let completed = stored.map(normalize).filter((route) => path.includes(route));

            const countEl = controls.querySelector<HTMLElement>('[data-fp-count]');
            const continueEl = controls.querySelector<HTMLAnchorElement>('[data-fp-continue]');
            const doneEl = controls.querySelector<HTMLElement>('[data-fp-done]');
            const toggleEl = controls.querySelector<HTMLButtonElement>('[data-fp-toggle]');

            const isDone = (route: string): boolean => completed.includes(route);

            const render = (): void => {
              const doneCount = path.filter(isDone).length;
              const allDone = doneCount === path.length;
              if (countEl) countEl.textContent = `${doneCount} / ${path.length} completed`;
              if (toggleEl) {
                const done = isDone(current);
                toggleEl.setAttribute('aria-pressed', String(done));
                toggleEl.textContent = done ? '✓ Completed' : '✓ Mark as complete';
              }
              if (continueEl && doneEl) {
                doneEl.hidden = !allDone;
                if (allDone) {
                  continueEl.hidden = true;
                } else {
                  // Progress-derived: next incomplete article after the
                  // current one, else the first incomplete one.
                  const currentIndex = path.indexOf(current);
                  const forward = path.slice(currentIndex + 1).find((r) => !isDone(r));
                  const target = forward ?? path.find((r) => !isDone(r));
                  if (target && target !== current) {
                    continueEl.href = target;
                    continueEl.setAttribute(
                      'aria-label',
                      'Continue to the next incomplete article',
                    );
                    continueEl.hidden = false;
                  } else {
                    continueEl.hidden = true;
                  }
                }
              }
              controls.hidden = false;
            };

            const setDone = (route: string, done: boolean): void => {
              const next = new Set(completed);
              if (done) next.add(route);
              else next.delete(route);
              completed = path.filter((r) => next.has(r));
              try {
                localStorage.setItem(STORE_KEY, JSON.stringify(completed));
              } catch {
                /* storage unavailable — keep the in-memory state */
              }
              render();
            };

            toggleEl?.addEventListener('click', () => {
              setDone(current, toggleEl.getAttribute('aria-pressed') !== 'true');
            });

            // Auto-complete on reaching the article's end: requires a real
            // scroll first (never on load) plus a short dwell.
            const endMarker = document.querySelector('[data-fp-end]');
            let scrolled = false;
            let dwell: ReturnType<typeof setTimeout> | undefined;
            const onScroll = (): void => {
              scrolled = true;
              window.removeEventListener('scroll', onScroll);
            };
            window.addEventListener('scroll', onScroll, { passive: true });
            if (endMarker && 'IntersectionObserver' in window) {
              const io = new IntersectionObserver((entries) => {
                for (const entry of entries) {
                  if (entry.isIntersecting && scrolled) {
                    dwell = window.setTimeout(() => setDone(current, true), 800);
                  } else if (dwell !== undefined) {
                    clearTimeout(dwell);
                    dwell = undefined;
                  }
                }
              });
              io.observe(endMarker);
            }

            render();
          }
        }
      </script>

      <RelatedTopics entry={entry} />
    </main>

    <!-- Table of contents (desktop) -->
    <aside
      class="sticky top-14 hidden max-h-[calc(100vh-3.5rem)] w-56 shrink-0 overflow-y-auto py-10 xl:block"
    >
      <TableOfContents headings={headings} />
    </aside>
  </div>

  <DocEnhancements />
  <MermaidRuntime />

  <!-- Sidebar collapse + resize controls (desktop). -->
  <script>
    const root = document.documentElement;
    const STORE_W = 'atlas-sidebar-w';
    const STORE_C = 'atlas-sidebar-collapsed';
    const DEFAULT_W = 256;
    const MIN_W = 200;
    const MAX_W = 440;

    const writeStore = (key: string, value: string) => {
      try {
        localStorage.setItem(key, value);
      } catch {
        /* storage unavailable */
      }
    };

    const toggle = document.querySelector<HTMLButtonElement>('[data-sidebar-toggle]');
    const grip = document.querySelector<HTMLElement>('[data-sidebar-resize]');

    const clamp = (px: number) => Math.min(MAX_W, Math.max(MIN_W, Math.round(px)));

    const currentWidth = (): number => {
      const raw = getComputedStyle(root).getPropertyValue('--docs-sidebar-w');
      const px = parseInt(raw, 10);
      return Number.isFinite(px) ? px : DEFAULT_W;
    };

    const setWidth = (px: number) => root.style.setProperty('--docs-sidebar-w', `${px}px`);

    // --- Collapse / expand -------------------------------------------------
    const applyToggleState = (collapsed: boolean, persist = true) => {
      root.classList.toggle('sb-collapsed', collapsed);
      const label = collapsed ? 'Expand sidebar' : 'Collapse sidebar';
      toggle?.setAttribute('aria-expanded', String(!collapsed));
      toggle?.setAttribute('aria-label', label);
      toggle?.setAttribute('title', label);
      if (persist) writeStore(STORE_C, collapsed ? '1' : '0');
    };

    // Sync button state with whatever the inline script restored.
    applyToggleState(root.classList.contains('sb-collapsed'), false);

    toggle?.addEventListener('click', () => {
      applyToggleState(!root.classList.contains('sb-collapsed'));
    });

    // --- Resize by dragging the edge grip ---------------------------------
    if (grip) {
      let dragging = false;
      let startX = 0;
      let startW = DEFAULT_W;

      grip.addEventListener('pointerdown', (event) => {
        if (event.button !== 0) return;
        dragging = true;
        startX = event.clientX;
        startW = currentWidth();
        grip.setPointerCapture(event.pointerId);
        document.body.classList.add('is-resizing');
        event.preventDefault();
      });

      grip.addEventListener('pointermove', (event) => {
        if (!dragging) return;
        const sign = root.dir === 'rtl' ? -1 : 1;
        setWidth(clamp(startW + (event.clientX - startX) * sign));
      });

      const endDrag = (event: PointerEvent) => {
        if (!dragging) return;
        dragging = false;
        document.body.classList.remove('is-resizing');
        try {
          grip.releasePointerCapture(event.pointerId);
        } catch {
          /* pointer already released */
        }
        writeStore(STORE_W, `${currentWidth()}px`);
      };
      grip.addEventListener('pointerup', endDrag);
      grip.addEventListener('pointercancel', endDrag);

      // Double-click resets to the default width.
      grip.addEventListener('dblclick', () => {
        root.style.removeProperty('--docs-sidebar-w');
        try {
          localStorage.removeItem(STORE_W);
        } catch {
          /* storage unavailable */
        }
      });

      // Keyboard resizing when the grip is focused.
      grip.addEventListener('keydown', (event) => {
        const step = event.shiftKey ? 32 : 16;
        let next: number | null = null;
        if (event.key === 'ArrowLeft') next = currentWidth() - step;
        else if (event.key === 'ArrowRight') next = currentWidth() + step;
        else if (event.key === 'Home') next = MIN_W;
        else if (event.key === 'End') next = MAX_W;
        if (next === null) return;
        event.preventDefault();
        const width = clamp(next);
        setWidth(width);
        writeStore(STORE_W, `${width}px`);
      });
    }
  </script>
</BaseLayout>
