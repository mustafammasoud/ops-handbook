---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Callout from '../components/Callout.astro';
import Steps from '../components/Steps.astro';
import Figure from '../components/Figure.astro';
import InfoCard from '../components/InfoCard.astro';
import PdfCard from '../components/PdfCard.astro';
import PdfEmbed from '../components/PdfEmbed.astro';
import DocEnhancements from '../components/DocEnhancements.astro';

const sampleDiagram = `data:image/svg+xml,${encodeURIComponent(`<svg xmlns="http://www.w3.org/2000/svg" width="600" height="160" viewBox="0 0 600 160"><defs><marker id="arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse"><path d="M0 0 L10 5 L0 10 z" fill="#70695f"/></marker></defs><rect width="600" height="160" fill="#fffaf1" rx="8"/><g fill="#f1e7d6" stroke="#d8cdbb" stroke-width="1.5"><rect x="30" y="55" width="150" height="50" rx="8"/><rect x="225" y="55" width="150" height="50" rx="8"/><rect x="420" y="55" width="150" height="50" rx="8"/></g><g stroke="#70695f" stroke-width="1.5" fill="none" marker-end="url(#arrow)"><path d="M185 80 H213"/><path d="M380 80 H408"/></g><g fill="#25231f" font-family="Segoe UI, Tahoma, Arial, sans-serif" font-size="15" text-anchor="middle" dominant-baseline="middle"><text x="105" y="81">First step</text><text x="300" y="81">Second step</text><text x="495" y="81">Third step</text></g></svg>`)}`;
---

<!--
  Platform QA page: renders every documentation component in one place.
  Not linked from the navigation; referenced from README.md / content/README.md.
-->
<BaseLayout
  title="UI Components | Ops Handbook"
  description="Preview of the Ops Handbook documentation components."
  noindex
>
  <Header />

  <main id="main" class="mx-auto w-full max-w-3xl px-4 py-10">
    <div class="prose">
      <h1>UI Components</h1>
      <p>
        QA page for the components available in MDX content. All strings here are
        placeholder text for display purposes only.
      </p>

      <h2 id="callouts">Callout</h2>
      <Callout>A regular note used for supporting details.</Callout>
      <Callout type="tip" title="Tip">A short tip with a custom title.</Callout>
      <Callout type="warning">A warning to avoid a common mistake.</Callout>
      <Callout type="lab">A lab box for a hands-on exercise.</Callout>

      <h2 id="steps">Steps</h2>
      <Steps>
        <li>The first step — placeholder text only.</li>
        <li>
          The second step —
          <code>npm run build</code>
        </li>
        <li>The third step — placeholder text only.</li>
      </Steps>

      <h2 id="info-card">Info card</h2>
      <InfoCard
        title="Node 1 — General Purpose"
        description="A general-purpose worker node."
        icon="cube"
        tags={['frontend', 'backend']}
      />
      <div class="grid gap-4 sm:grid-cols-3">
        <InfoCard
          variant="comparison"
          title="Option A"
          description="One of several related options."
          icon="shield"
          tags={['hard']}
        />
        <InfoCard
          variant="comparison"
          title="Option B"
          description="A softer alternative."
          icon="sliders"
          tags={['soft']}
        />
        <InfoCard
          variant="comparison"
          title="Option C"
          description="The most disruptive one."
          icon="cycle"
          tags={['evicts']}
        />
      </div>
      <InfoCard variant="insight" title="Key takeaway" icon="pulse">
        <p>Important distinction readers often get wrong.</p>
      </InfoCard>
      <InfoCard title="Minimal card" description="Title and description only." />
      <InfoCard title="Title only" />

      <h2 id="figure">Figure</h2>
      <Figure
        src={sampleDiagram}
        alt="Sample diagram (placeholder three-step flow)"
        caption="Sample caption below the figure."
      />

      <h2 id="code">Code block + copy button</h2>
      <pre class="astro-code" data-language="bash"><code>echo "copy button is added client-side"</code></pre>

      <h2 id="pdf">PDF</h2>
      <PdfCard
        href="/pdf/linux-cheatsheet.pdf"
        title="linux-cheatsheet.pdf"
        description="File card: open and download."
      />
      <PdfEmbed src="/pdf/linux-cheatsheet.pdf" title="Sample PDF preview" height={480} />
    </div>
  </main>

  <DocEnhancements />
</BaseLayout>
