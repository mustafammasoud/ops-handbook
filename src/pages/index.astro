---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import CategoryCard from '../components/CategoryCard.astro';
import CategoryIcon from '../components/CategoryIcon.astro';
import SocialIcon from '../components/SocialIcon.astro';
import {
  categories,
  categoryLabel,
  toolLabel,
  levelLabel,
} from '../data/categories';
import {
  docCategory,
  docPath,
  docTool,
  sortedDocs,
  latestDocs,
} from '../utils/docs';

/**
 * The homepage shows a curated subset of the documentation areas;
 * /docs keeps listing all of them. Metadata stays in `categories` —
 * this is only a selection of ids, in display order.
 */
const HOMEPAGE_AREA_IDS = [
  'devops-fundamentals',
  'operating-systems',
  'networking',
  'version-control',
  'programming-scripting',
  'containers',
  'ci-cd-automation',
  'container-orchestration',
];
const homepageAreas = categories.filter((category) =>
  HOMEPAGE_AREA_IDS.includes(category.id),
);

const docs = sortedDocs(await getCollection('docs', ({ data }) => !data.draft));

const counts = new Map<string, number>();
for (const doc of docs) {
  const cat = docCategory(doc);
  counts.set(cat, (counts.get(cat) ?? 0) + 1);
}

// Fundamentals learning sequence: 9 articles in canonical order
const fundamentalsDocs = docs.filter(
  (doc) => docCategory(doc) === 'devops-fundamentals',
);

// Primary CTA: begin with DevOps Fundamentals when it has content, else the first
// available topic.
const primaryTarget = fundamentalsDocs[0] ?? docs[0];

// Latest articles: 3-4 articles sorted by recency/order
const latestArticles = latestDocs(docs, 4);

// Handbook statistics (dynamically derived)
const totalArticles = docs.length;
const totalAreas = categories.length;
const fundamentalsCount = fundamentalsDocs.length;

// Ecosystem strip: communicates the infrastructure toolchain, LTR like code.
const ecosystem = [
  { icon: 'terminal' as const, label: 'Linux' },
  { icon: 'cube' as const, label: 'Docker' },
  { icon: 'wheel' as const, label: 'Kubernetes' },
  { icon: 'modules' as const, label: 'Terraform' },
  { icon: 'cloud' as const, label: 'Cloud' },
  { icon: 'cycle' as const, label: 'CI/CD' },
];
---

<BaseLayout
  title="Ops Handbook — DevOps Knowledge Base"
  description="A practical DevOps knowledge base covering fundamentals, Linux, containers, Kubernetes, CI/CD, cloud, infrastructure, and production operations."
  hideFooter={true}
>
  <Header />

  <main id="main" class="mx-auto w-full max-w-screen-2xl px-4">
    <!-- Hero -->
    <section class="max-w-2xl pt-14 pb-12 sm:pt-20">
      <h1 class="text-3xl font-semibold leading-tight tracking-tight sm:text-4xl">
        Ops Handbook
      </h1>

      <p
        class="mt-5 text-xl font-medium leading-snug text-text text-balance"
      >
        Your structured DevOps knowledge base — from fundamentals to production.
      </p>

      <p class="mt-3 leading-relaxed text-muted">
        Documentation, hands-on labs, diagrams, and command references — all stored as
        Markdown files in the repository, built for long reading sessions and repeated
        reference.
      </p>

      <div class="mt-7 flex flex-wrap gap-3">
        {
          primaryTarget && (
            <a
              href={docPath(primaryTarget.id)}
              class="rounded-md bg-accent-fill px-4 py-2.5 text-sm font-medium text-accent-contrast transition-opacity hover:opacity-90"
            >
              Start with the fundamentals
            </a>
          )
        }
        <a
          href="/docs"
          class="rounded-md border border-border bg-surface px-4 py-2.5 text-sm font-medium transition-colors hover:border-accent/50 hover:text-accent-ink"
        >
          Browse the documentation
        </a>
      </div>

      <!-- Technical ecosystem visual (monochrome, no stock images) -->
      <ul
        class="mt-10 flex flex-wrap items-center gap-x-2 gap-y-3 text-muted"
        dir="ltr"
        aria-label="Platform technologies"
      >
        {
          ecosystem.map((item, index) => (
            <li class="flex items-center gap-2">
              {index > 0 && (
                <span class="text-border" aria-hidden="true">
                  →
                </span>
              )}
              <span class="flex items-center gap-1.5 px-1.5 py-1">
                <CategoryIcon name={item.icon} class="h-5 w-5" />
                <span class="text-xs font-medium tracking-wide" lang="en">
                  {item.label}
                </span>
              </span>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- Orientation: Area → Tool → Article (real, verified example chain) -->
    <section
      class="border-t border-border py-12"
      aria-labelledby="orientation-heading"
    >
      <div class="mb-6">
        <h2 id="orientation-heading" class="text-lg font-semibold">
          How the documentation is organized
        </h2>
        <p class="mt-1 text-sm text-muted">
          Every page follows the same three levels — Area, Tool, and Article.
        </p>
      </div>

      <ol class="grid gap-y-8 sm:grid-cols-3 sm:gap-x-12">
        <li class="relative">
          <div class="flex items-center gap-2">
            <CategoryIcon name="layers" class="h-4 w-4 text-muted" />
            <h3 class="text-xs font-semibold uppercase tracking-wider text-muted">
              Area
            </h3>
          </div>
          <p class="mt-2 text-sm leading-relaxed text-text">
            A knowledge domain — a family of related tools and subjects.
          </p>
          <a
            href="/docs/container-orchestration"
            class="mt-2.5 inline-flex items-center gap-1 text-sm font-medium text-accent-ink transition-opacity hover:opacity-80"
          >
            Container Orchestration
            <span aria-hidden="true" class="text-xs">&rarr;</span>
          </a>
          <span
            aria-hidden="true"
            class="absolute -right-6 top-0 hidden text-border sm:block"
          >
            &rarr;
          </span>
          <span
            aria-hidden="true"
            class="mt-4 block text-center text-border sm:hidden"
          >
            &darr;
          </span>
        </li>

        <li class="relative">
          <div class="flex items-center gap-2">
            <CategoryIcon name="cube" class="h-4 w-4 text-muted" />
            <h3 class="text-xs font-semibold uppercase tracking-wider text-muted">
              Tool
            </h3>
          </div>
          <p class="mt-2 text-sm leading-relaxed text-text">
            A technology grouped inside an Area — the subject you work with.
          </p>
          <a
            href="/docs/container-orchestration/kubernetes"
            class="mt-2.5 inline-flex items-center gap-1 text-sm font-medium text-accent-ink transition-opacity hover:opacity-80"
          >
            Kubernetes
            <span aria-hidden="true" class="text-xs">&rarr;</span>
          </a>
          <span
            aria-hidden="true"
            class="absolute -right-6 top-0 hidden text-border sm:block"
          >
            &rarr;
          </span>
          <span
            aria-hidden="true"
            class="mt-4 block text-center text-border sm:hidden"
          >
            &darr;
          </span>
        </li>

        <li class="relative">
          <div class="flex items-center gap-2">
            <CategoryIcon name="code" class="h-4 w-4 text-muted" />
            <h3 class="text-xs font-semibold uppercase tracking-wider text-muted">
              Article
            </h3>
          </div>
          <p class="mt-2 text-sm leading-relaxed text-text">
            A single page — a concept, guide, lab, or command reference.
          </p>
          <a
            href="/docs/container-orchestration/kubernetes/scheduling/taints-and-tolerations"
            class="mt-2.5 inline-flex items-center gap-1 text-sm font-medium text-accent-ink transition-opacity hover:opacity-80"
          >
            Taints &amp; Tolerations
            <span aria-hidden="true" class="text-xs">&rarr;</span>
          </a>
        </li>
      </ol>
    </section>

    <!-- Start Here: Fundamentals Learning Sequence -->
    {
      fundamentalsDocs.length > 0 && (
        <section
          class="border-t border-border py-12"
          aria-labelledby="start-here-heading"
        >
          <div class="mb-6 flex flex-wrap items-baseline justify-between gap-4">
            <div>
              <h2
                id="start-here-heading"
                class="text-xs font-semibold uppercase tracking-wider text-muted"
              >
                Start Here
              </h2>
              <a
                href={docPath(primaryTarget.id)}
                class="group mt-1 inline-flex items-center gap-1.5 text-lg font-semibold tracking-tight text-text transition-colors hover:text-accent-ink sm:text-xl"
              >
                <span>New to DevOps? Start with the Fundamentals</span>
                <span
                  class="transition-transform group-hover:translate-x-0.5"
                  aria-hidden="true"
                >
                  &rarr;
                </span>
              </a>
            </div>
          </div>

          <ol class="grid border-b border-border sm:grid-cols-2 lg:grid-cols-3 sm:gap-x-8">
            {fundamentalsDocs.map((doc, index) => (
              <li class="border-t border-border">
                <a
                  href={docPath(doc.id)}
                  class="group flex items-baseline gap-3.5 py-4 transition-colors hover:text-accent-ink"
                >
                  <span class="shrink-0 font-mono text-xs font-semibold text-muted tabular-nums group-hover:text-accent-ink">
                    {String(index + 1).padStart(2, '0')}
                  </span>
                  <div class="min-w-0 flex-1">
                    <span class="block text-sm font-semibold tracking-tight text-text group-hover:text-accent-ink">
                      {doc.data.title}
                    </span>
                    {doc.data.description && (
                      <span class="mt-1 block text-xs leading-relaxed text-muted line-clamp-2">
                        {doc.data.description}
                      </span>
                    )}
                  </div>
                </a>
              </li>
            ))}
          </ol>
        </section>
      )
    }

    <!-- Latest Articles -->
    {
      latestArticles.length > 0 && (
        <section
          class="border-t border-border py-12"
          aria-labelledby="latest-heading"
        >
          <div class="mb-6">
            <h2 id="latest-heading" class="text-lg font-semibold">
              Latest articles
            </h2>
            <p class="mt-1 text-sm text-muted">
              Recently published guides and references across the handbook.
            </p>
          </div>

          <ul class="grid border-b border-border sm:grid-cols-2 sm:gap-x-12">
            {latestArticles.map((doc) => {
              const areaId = docCategory(doc);
              const toolId = docTool(doc);
              const area = categoryLabel(areaId);
              const tool = toolId ? toolLabel(toolId) : undefined;
              return (
                <li class="border-t border-border">
                  <a
                    href={docPath(doc.id)}
                    class="group flex flex-col justify-between py-5 transition-colors hover:bg-surface/70"
                  >
                    <div>
                      <div class="flex flex-wrap items-center gap-2 text-xs text-muted">
                        <span class="font-medium text-text">{area}</span>
                        {tool && (
                          <>
                            <span class="text-border" aria-hidden="true">
                              &middot;
                            </span>
                            <span
                              class="rounded border border-border bg-surface px-1.5 py-0.5"
                              lang="en"
                            >
                              {tool}
                            </span>
                          </>
                        )}
                        <span class="ml-auto rounded-full border border-border bg-surface px-2.5 py-0.5 text-xs text-muted">
                          {levelLabel(doc.data.level)}
                        </span>
                      </div>

                      <h3 class="mt-2 text-base font-semibold tracking-tight text-text group-hover:text-accent-ink">
                        {doc.data.title}
                      </h3>

                      {doc.data.description && (
                        <p class="mt-1 text-sm leading-relaxed text-muted line-clamp-2">
                          {doc.data.description}
                        </p>
                      )}
                    </div>
                  </a>
                </li>
              );
            })}
          </ul>
        </section>
      )
    }

    <!-- Documentation areas: editorial index rows -->
    <section class="border-t border-border py-12" aria-labelledby="areas-heading">
      <div class="mb-4 flex items-baseline justify-between gap-4">
        <h2 id="areas-heading" class="text-lg font-semibold">
          Documentation areas
        </h2>
        <a
          href="/docs"
          class="text-sm text-muted transition-colors hover:text-accent-ink"
        >
          View all →
        </a>
      </div>

      <ul class="grid border-b border-border sm:grid-cols-2 sm:gap-x-12">
        {
          homepageAreas.map((category) => (
            <CategoryCard category={category} count={counts.get(category.id) ?? 0} />
          ))
        }
      </ul>
    </section>

    <!-- Handbook statistics / analysis -->
    <section
      class="border-t border-border py-12"
      aria-labelledby="statistics-heading"
    >
      <div class="mb-6">
        <h2 id="statistics-heading" class="text-lg font-semibold">
          Handbook overview
        </h2>
        <p class="mt-1 text-sm text-muted">
          Key metrics and content distribution across the documentation.
        </p>
      </div>

      <div class="grid grid-cols-1 gap-4 sm:grid-cols-3">
        <div
          class="group rounded-lg border border-border bg-surface p-5 shadow-card transition-colors hover:border-accent/40 sm:p-6"
        >
          <div class="flex items-center justify-between">
            <span
              class="text-3xl font-semibold tracking-tight text-text tabular-nums group-hover:text-accent-ink sm:text-4xl"
            >
              {totalArticles}
            </span>
            <span
              class="rounded border border-border bg-surface px-2 py-0.5 text-xs font-medium text-muted"
            >
              Published
            </span>
          </div>
          <span class="mt-3 block text-sm font-semibold tracking-tight text-text">
            Total Articles
          </span>
          <p class="mt-1 text-xs leading-relaxed text-muted">
            Technical guides, labs, diagrams, and command references.
          </p>
        </div>

        <div
          class="group rounded-lg border border-border bg-surface p-5 shadow-card transition-colors hover:border-accent/40 sm:p-6"
        >
          <div class="flex items-center justify-between">
            <span
              class="text-3xl font-semibold tracking-tight text-text tabular-nums group-hover:text-accent-ink sm:text-4xl"
            >
              {totalAreas}
            </span>
            <span
              class="rounded border border-border bg-surface px-2 py-0.5 text-xs font-medium text-muted"
            >
              Curated
            </span>
          </div>
          <span class="mt-3 block text-sm font-semibold tracking-tight text-text">
            Documentation Areas
          </span>
          <p class="mt-1 text-xs leading-relaxed text-muted">
            Covering systems, networking, containers, CI/CD, and orchestration.
          </p>
        </div>

        <div
          class="group rounded-lg border border-border bg-surface p-5 shadow-card transition-colors hover:border-accent/40 sm:p-6"
        >
          <div class="flex items-center justify-between">
            <span
              class="text-3xl font-semibold tracking-tight text-text tabular-nums group-hover:text-accent-ink sm:text-4xl"
            >
              {fundamentalsCount}
            </span>
            <span
              class="rounded border border-border bg-surface px-2 py-0.5 text-xs font-medium text-muted"
            >
              Core Path
            </span>
          </div>
          <span class="mt-3 block text-sm font-semibold tracking-tight text-text">
            Fundamentals Articles
          </span>
          <p class="mt-1 text-xs leading-relaxed text-muted">
            The sequential foundational path for new DevOps learners.
          </p>
        </div>
      </div>
    </section>

  </main>

  <!-- Author attribution footer -->
  <footer
    class="border-t border-border py-8"
    aria-label="Site footer"
    style="padding-bottom: calc(2rem + env(safe-area-inset-bottom, 0px));"
  >
    <div class="mx-auto flex w-full max-w-screen-2xl flex-wrap items-center justify-between gap-x-8 gap-y-4 px-4">
      <p
        class="max-w-2xl text-sm leading-relaxed text-muted"
      >
        Built and maintained by Mustafa Masoud — a personal knowledge base for
        learning and documenting DevOps.
      </p>

      <ul class="flex flex-wrap items-center gap-x-5 gap-y-2">
        <li>
          <a
            href="https://github.com/mustafammasoud"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 text-sm text-muted transition-colors hover:text-accent-ink focus-visible:text-accent-ink"
            lang="en"
          >
            <SocialIcon name="github" class="h-5 w-5 shrink-0" />
            <span>GitHub</span>
          </a>
        </li>
        <li>
          <a
            href="https://www.linkedin.com/in/mustafammasoud/"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 text-sm text-muted transition-colors hover:text-accent-ink focus-visible:text-accent-ink"
            lang="en"
          >
            <SocialIcon name="linkedin" class="h-5 w-5 shrink-0" />
            <span>LinkedIn</span>
          </a>
        </li>
        <li>
          <a
            href="mailto:masoudmustafa90@gmail.com"
            class="inline-flex items-center gap-1.5 text-sm text-muted transition-colors hover:text-accent-ink focus-visible:text-accent-ink"
            lang="en"
          >
            <SocialIcon name="mail" class="h-5 w-5 shrink-0" />
            <span>Email</span>
          </a>
        </li>
      </ul>
    </div>
  </footer>
</BaseLayout>
