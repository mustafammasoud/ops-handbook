---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import ArrowButton from '../components/ArrowButton.astro';
import CategoryCard from '../components/CategoryCard.astro';
import CategoryIcon from '../components/CategoryIcon.astro';
import SocialIcon from '../components/SocialIcon.astro';
import AnimatedTerminal from '../components/AnimatedTerminal.astro';
import {
  categories,
  type CategoryStatus,
} from '../data/categories';
import {
  articleCount,
  docCategory,
  docPath,
  sortedDocs,
} from '../utils/docs';
import { aggregateTechQuestions } from '../utils/interview';

/**
 * The homepage acts as the central Knowledge Hub landing page, introducing
 * the three independent pillars: Docs, Cheat Sheets, and Interview Questions.
 */
const HOMEPAGE_AREA_IDS = [
  'container-orchestration',
  'networking',
  'version-control',
  'operating-systems',
];
const homepageAreas = HOMEPAGE_AREA_IDS.flatMap((id) => {
  const category = categories.find((item) => item.id === id);
  return category ? [category] : [];
});

// Dynamic build-time collection aggregation
const docs = sortedDocs(await getCollection('docs', ({ data }) => !data.draft));
const totalArticles = docs.length;

const cheatSheets = await getCollection('cheatSheets', ({ data }) => !data.draft);
const totalCheatTopics = cheatSheets.length;

const interviewQuestions = await getCollection('interviewQuestions', ({ data }) => !data.draft);
const interviewStats = aggregateTechQuestions(interviewQuestions);
const totalInterviewQuestions = interviewStats.total;

const counts = new Map<string, number>();
for (const doc of docs) {
  const cat = docCategory(doc);
  counts.set(cat, (counts.get(cat) ?? 0) + 1);
}

// Fundamentals learning sequence: 9 articles in canonical order
const fundamentalsDocs = docs.filter(
  (doc) => docCategory(doc) === 'devops-fundamentals',
);

// Start Here: 3 curated fundamentals articles, selected by id (not index).
const START_HERE_IDS = [
  'devops-fundamentals/what-is-devops',
  'devops-fundamentals/why-devops',
  'devops-fundamentals/ci-cd-fundamentals',
];
const startHereDocs = START_HERE_IDS.flatMap((id) => {
  const doc = docs.find((d) => d.id === id);
  return doc ? [doc] : [];
});

// Coverage & Roadmap: per-area status.
const areaRows = categories.map((category) => {
  const count = counts.get(category.id) ?? 0;
  const status: CategoryStatus =
    category.status ?? (count > 0 ? 'published' : 'planned');
  return { category, count, status };
});

const STATUS_ORDER: Record<CategoryStatus, number> = {
  published: 0,
  'in-progress': 1,
  planned: 2,
};
const groupedAreas = [...areaRows].sort(
  (a, b) =>
    STATUS_ORDER[a.status] - STATUS_ORDER[b.status] ||
    a.category.order - b.category.order,
);

const publishedAreaCount = areaRows.filter((row) => row.count > 0).length;
const plannedAreaCount = areaRows.filter((row) => row.count === 0).length;

const STATUS_BADGES: Record<CategoryStatus, { label: string; cls: string }> = {
  published: {
    label: 'Published',
    cls: 'border-border-light bg-accent-soft text-accent-ink',
  },
  'in-progress': {
    label: 'In progress',
    cls: 'border-warning-border bg-warning-bg text-warning-fg',
  },
  planned: {
    label: 'Planned',
    cls: 'border-border-light bg-surface-2 text-muted',
  },
};

// Ecosystem strip: communicates the infrastructure toolchain
const ecosystem = [
  { icon: 'terminal' as const, label: 'Linux' },
  { icon: 'cube' as const, label: 'Docker' },
  { icon: 'wheel' as const, label: 'Kubernetes' },
  { icon: 'modules' as const, label: 'Terraform' },
  { icon: 'cloud' as const, label: 'Cloud' },
  { icon: 'cycle' as const, label: 'CI/CD' },
];
---

<BaseLayout
  title="Ops Handbook — DevOps Knowledge Base"
  description="A practical DevOps knowledge base covering fundamentals, Linux, containers, Kubernetes, CI/CD, cloud, infrastructure, and production operations."
  hideFooter={true}
>
  <Header />

  <main id="main" class="mx-auto w-full max-w-screen-2xl px-4">
    <!-- Knowledge Hub Hero -->
    <section class="pt-12 pb-10 sm:pt-16 sm:pb-14">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-8 items-center">
        <!-- Left: Hero Text, Metrics & Ecosystem (6 cols on lg) -->
        <div class="lg:col-span-6 max-w-xl">
          <div class="mb-3 inline-flex items-center gap-2 rounded-full border border-border bg-surface px-3 py-1 text-xs font-medium text-accent-ink">
            <span>DevOps Knowledge Hub</span>
          </div>

          <h1 class="text-3xl font-semibold leading-tight tracking-tight sm:text-5xl text-text">
            Ops Handbook
          </h1>

          <p class="mt-4 text-xl font-medium leading-snug text-text text-balance sm:text-2xl">
            An engineering knowledge base for DevOps, systems, and cloud infrastructure.
          </p>

          <p class="mt-3 text-base leading-relaxed text-muted max-w-xl">
            Organized into three independent pillars: deep technical documentation, fast command cheat sheets, and structured technical interview preparation.
          </p>

          <!-- Dynamic Knowledge Hub Metrics (Calculated at build time) -->
          <div class="mt-6 flex flex-wrap items-center gap-2.5 text-xs font-mono">
            <span class="inline-flex items-center gap-1.5 rounded-lg border border-border bg-surface px-3 py-1.5 text-text shadow-2xs">
              <span class="h-2 w-2 rounded-full bg-accent"></span>
              <strong class="font-bold text-accent-ink">{totalArticles}</strong> Published Articles
            </span>
            <span class="inline-flex items-center gap-1.5 rounded-lg border border-border bg-surface px-3 py-1.5 text-text shadow-2xs">
              <span class="h-2 w-2 rounded-full bg-accent"></span>
              <strong class="font-bold text-accent-ink">{totalCheatTopics}</strong> Cheat Sheet Topics
            </span>
            <span class="inline-flex items-center gap-1.5 rounded-lg border border-border bg-surface px-3 py-1.5 text-text shadow-2xs">
              <span class="h-2 w-2 rounded-full bg-accent"></span>
              <strong class="font-bold text-accent-ink">{totalInterviewQuestions}</strong> Interview Questions
            </span>
          </div>

          <!-- Technical ecosystem visual -->
          <ul
            class="mt-7 flex flex-wrap items-center gap-x-2 gap-y-2.5 text-muted"
            dir="ltr"
            aria-label="Platform technologies"
          >
            {
              ecosystem.map((item, index) => (
                <li class="flex items-center gap-2">
                  {index > 0 && (
                    <svg
                      class="h-4 w-4 shrink-0 text-border"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M5 12h14"></path>
                      <path d="m12 5 7 7-7 7"></path>
                    </svg>
                  )}
                  <span class="flex items-center gap-1.5 rounded-full border border-border bg-surface px-3 py-1.5">
                    <CategoryIcon name={item.icon} class="h-4 w-4 text-accent-ink" />
                    <span class="text-xs font-medium tracking-wide" lang="en">
                      {item.label}
                    </span>
                  </span>
                </li>
              ))
            }
          </ul>
        </div>

        <!-- Right: Animated Terminal (6 cols on lg) -->
        <div class="lg:col-span-6 flex justify-center lg:justify-end w-full">
          <AnimatedTerminal />
        </div>
      </div>
    </section>

    <!-- Three Independent Pillars -->
    <section class="border-t border-border py-12" aria-labelledby="pillars-heading">
      <div class="mb-8">
        <h2 id="pillars-heading" class="text-xs font-semibold uppercase tracking-wider text-muted">
          Three Independent Pillars
        </h2>
        <p class="mt-1 text-xl font-bold tracking-tight text-text sm:text-2xl">
          Choose the format that fits your immediate objective
        </p>
      </div>

      <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
        <!-- Pillar A: Docs -->
        <div class="group relative flex flex-col justify-between rounded-2xl border border-border bg-surface p-6 transition-all hover:border-accent/50 hover:bg-surface-2 hover:shadow-xs">
          <div>
            <div class="flex items-center justify-between gap-2 mb-4">
              <div class="flex h-11 w-11 items-center justify-center rounded-xl border border-border bg-surface-2 text-accent-ink">
                <CategoryIcon name="modules" class="h-6 w-6" />
              </div>
              <span class="rounded-full bg-accent/15 px-2.5 py-0.5 text-xs font-mono font-semibold text-accent-ink">
                {totalArticles} Articles
              </span>
            </div>

            <h3 class="text-lg font-bold text-text group-hover:text-accent-ink transition-colors">
              Docs
            </h3>
            <p class="mt-2 text-sm text-text-body font-medium leading-relaxed">
              Deep learning, technical explanations, and structured documentation.
            </p>
            <p class="mt-2 text-xs text-muted leading-relaxed">
              Comprehensive architectural guides, core fundamentals, production setup, and operational best practices.
            </p>

            <div class="mt-4 flex flex-wrap gap-1.5 text-[11px] font-mono text-muted">
              <span class="rounded bg-surface-2 px-1.5 py-0.5">Architecture</span>
              <span class="rounded bg-surface-2 px-1.5 py-0.5">Kubernetes</span>
              <span class="rounded bg-surface-2 px-1.5 py-0.5">Linux</span>
              <span class="rounded bg-surface-2 px-1.5 py-0.5">Networking</span>
            </div>
          </div>

          <div class="mt-6 pt-4 border-t border-border/70">
            <a
              href="/docs"
              class="inline-flex w-full items-center justify-between rounded-xl border border-accent/30 bg-accent/10 px-4 py-2.5 text-sm font-semibold text-accent-ink transition-colors hover:bg-accent hover:text-white dark:hover:text-black focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
            >
              <span>Explore Documentation</span>
              <svg aria-hidden="true" class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </a>
          </div>
        </div>

        <!-- Pillar B: Cheat Sheets -->
        <div class="group relative flex flex-col justify-between rounded-2xl border border-border bg-surface p-6 transition-all hover:border-accent/50 hover:bg-surface-2 hover:shadow-xs">
          <div>
            <div class="flex items-center justify-between gap-2 mb-4">
              <div class="flex h-11 w-11 items-center justify-center rounded-xl border border-border bg-surface-2 text-accent-ink">
                <CategoryIcon name="terminal" class="h-6 w-6" />
              </div>
              <span class="rounded-full bg-accent/15 px-2.5 py-0.5 text-xs font-mono font-semibold text-accent-ink">
                {totalCheatTopics} Topics
              </span>
            </div>

            <h3 class="text-lg font-bold text-text group-hover:text-accent-ink transition-colors">
              Cheat Sheets
            </h3>
            <p class="mt-2 text-sm text-text-body font-medium leading-relaxed">
              Quick lookup, commands, configurations, and practical references.
            </p>
            <p class="mt-2 text-xs text-muted leading-relaxed">
              Scannable command tables with one-click copy, real-world examples, and when-to-use guidance for fast troubleshooting.
            </p>

            <div class="mt-4 flex flex-wrap gap-1.5 text-[11px] font-mono text-muted">
              <span class="rounded bg-surface-2 px-1.5 py-0.5">Kubernetes CLI</span>
              <span class="rounded bg-surface-2 px-1.5 py-0.5">Git Workflows</span>
              <span class="rounded bg-surface-2 px-1.5 py-0.5">GitHub CLI</span>
            </div>
          </div>

          <div class="mt-6 pt-4 border-t border-border/70">
            <a
              href="/cheat-sheets"
              class="inline-flex w-full items-center justify-between rounded-xl border border-accent/30 bg-accent/10 px-4 py-2.5 text-sm font-semibold text-accent-ink transition-colors hover:bg-accent hover:text-white dark:hover:text-black focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
            >
              <span>Explore Cheat Sheets</span>
              <svg aria-hidden="true" class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </a>
          </div>
        </div>

        <!-- Pillar C: Interview Questions -->
        <div class="group relative flex flex-col justify-between rounded-2xl border border-border bg-surface p-6 transition-all hover:border-accent/50 hover:bg-surface-2 hover:shadow-xs">
          <div>
            <div class="flex items-center justify-between gap-2 mb-4">
              <div class="flex h-11 w-11 items-center justify-center rounded-xl border border-border bg-surface-2 text-accent-ink">
                <CategoryIcon name="wheel" class="h-6 w-6" />
              </div>
              <span class="rounded-full bg-accent/15 px-2.5 py-0.5 text-xs font-mono font-semibold text-accent-ink">
                {totalInterviewQuestions} Questions
              </span>
            </div>

            <h3 class="text-lg font-bold text-text group-hover:text-accent-ink transition-colors">
              Interview Questions
            </h3>
            <p class="mt-2 text-sm text-text-body font-medium leading-relaxed">
              Technical interview preparation, understanding concepts, and testing knowledge.
            </p>
            <p class="mt-2 text-xs text-muted leading-relaxed">
              Two-stage answer reveal, concise summaries for rapid recall, deep mechanics, candidate pitfalls, and follow-up questions.
            </p>

            <div class="mt-4 flex flex-wrap gap-1.5 text-[11px] font-mono text-muted">
              <span class="rounded bg-surface-2 px-1.5 py-0.5">Control Plane</span>
              <span class="rounded bg-surface-2 px-1.5 py-0.5">Linux Inodes</span>
              <span class="rounded bg-surface-2 px-1.5 py-0.5">Git Internals</span>
            </div>
          </div>

          <div class="mt-6 pt-4 border-t border-border/70">
            <a
              href="/interview-questions"
              class="inline-flex w-full items-center justify-between rounded-xl border border-accent/30 bg-accent/10 px-4 py-2.5 text-sm font-semibold text-accent-ink transition-colors hover:bg-accent hover:text-white dark:hover:text-black focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent"
            >
              <span>Explore Interview Questions</span>
              <svg aria-hidden="true" class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Start Here: Fundamentals Learning Sequence -->
    {
      startHereDocs.length > 0 && (
        <section
          class="border-t border-border py-12"
          aria-labelledby="start-here-heading"
        >
          <div class="mb-6 flex flex-wrap items-center justify-between gap-4">
            <div>
              <h2
                id="start-here-heading"
                class="text-xs font-semibold uppercase tracking-wider text-muted"
              >
                Start Here
              </h2>
              <p class="mt-1 text-lg font-semibold tracking-tight text-text sm:text-xl">
                New to DevOps? Start with the Fundamentals
              </p>
            </div>
            <ArrowButton
              href="/docs/devops-fundamentals"
              label={`View all ${fundamentalsDocs.length} fundamentals`}
            />
          </div>

          <ol class="grid gap-x-8 border-b border-border lg:grid-cols-3">
            {startHereDocs.map((doc, index) => (
              <li class="border-t border-border">
                <a
                  href={docPath(doc.id)}
                  class="group flex items-baseline gap-3.5 py-4 transition-colors hover:text-accent-ink"
                >
                  <span class="shrink-0 font-mono text-xs font-semibold text-muted tabular-nums group-hover:text-accent-ink">
                    {String(index + 1).padStart(2, '0')}
                  </span>
                  <div class="min-w-0 flex-1">
                    <span class="block text-sm font-semibold tracking-tight text-text group-hover:text-accent-ink">
                      {doc.data.title}
                    </span>
                    {doc.data.description && (
                      <span class="mt-1 block text-xs leading-relaxed text-muted line-clamp-2">
                        {doc.data.description}
                      </span>
                    )}
                  </div>
                </a>
              </li>
            ))}
          </ol>
        </section>
      )
    }

    <!-- Documentation areas: editorial index rows -->
    <section class="border-t border-border py-12" aria-labelledby="areas-heading">
      <div class="mb-4 flex flex-wrap items-center justify-between gap-4">
        <h2 id="areas-heading" class="text-lg font-semibold">
          Documentation areas
        </h2>
        <ArrowButton href="/docs" label="View all" />
      </div>

      <ul class="grid border-b border-border sm:grid-cols-2 sm:gap-x-12">
        {
          homepageAreas.map((category) => (
            <CategoryCard category={category} count={counts.get(category.id) ?? 0} />
          ))
        }
      </ul>
    </section>

    <!-- Coverage & Roadmap -->
    <section
      class="border-t border-border py-12"
      aria-labelledby="coverage-heading"
    >
      <div class="mb-6">
        <h2 id="coverage-heading" class="text-lg font-semibold">
          Coverage &amp; Roadmap
        </h2>
        <p class="mt-1 text-sm text-muted">
          The handbook is growing — here is where every documentation area stands.
        </p>
      </div>

      <!-- Compact stats row (all derived from the content collection) -->
      <dl class="mb-8 grid grid-cols-1 gap-3 sm:grid-cols-3">
        <div class="rounded-lg border border-border bg-surface px-4 py-3">
          <dt class="text-xs text-muted">Total articles</dt>
          <dd class="mt-0.5 text-2xl font-semibold tabular-nums text-text">
            {totalArticles}
          </dd>
        </div>
        <div class="rounded-lg border border-border bg-surface px-4 py-3">
          <dt class="text-xs text-muted">Published areas</dt>
          <dd class="mt-0.5 text-2xl font-semibold tabular-nums text-text">
            {publishedAreaCount}
          </dd>
        </div>
        <div class="rounded-lg border border-border bg-surface px-4 py-3">
          <dt class="text-xs text-muted">Planned areas</dt>
          <dd class="mt-0.5 text-2xl font-semibold tabular-nums text-text">
            {plannedAreaCount}
          </dd>
        </div>
      </dl>

      <!-- All 14 areas, grouped Published → In progress → Planned -->
      <ul class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {
          groupedAreas.map(({ category, count, status }) => {
            const badge = STATUS_BADGES[status];
            const quiet = status === 'planned';
            return (
              <li
                class:list={[
                  'flex items-start gap-3 rounded-lg border px-4 py-3',
                  quiet
                    ? 'border-border-light bg-transparent'
                    : 'border-border bg-surface',
                ]}
              >
                <CategoryIcon
                  name={category.icon}
                  class:list={[
                    'mt-0.5 h-5 w-5 shrink-0',
                    quiet ? 'text-muted/70' : 'text-muted',
                  ]}
                />
                <div class="min-w-0 flex-1">
                  <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
                    <span
                      class:list={[
                        'text-sm font-semibold tracking-tight',
                        quiet ? 'text-muted' : 'text-text',
                      ]}
                      lang="en"
                    >
                      {category.label}
                    </span>
                    <span
                      class:list={[
                        'rounded-full border px-2 py-0.5 text-[0.65rem] font-medium',
                        badge.cls,
                      ]}
                    >
                      {badge.label}
                    </span>
                  </div>
                  {!quiet && count > 0 && (
                    <span class="mt-1 block text-xs text-muted tabular-nums">
                      {articleCount(count)}
                    </span>
                  )}
                </div>
              </li>
            );
          })
        }
      </ul>
    </section>

  </main>

  <!-- Author attribution footer -->
  <footer
    class="border-t border-border py-8"
    aria-label="Site footer"
    style="padding-bottom: calc(2rem + env(safe-area-inset-bottom, 0px));"
  >
    <div class="mx-auto flex w-full max-w-screen-2xl flex-wrap items-center justify-between gap-x-8 gap-y-4 px-4">
      <p
        class="max-w-2xl text-sm leading-relaxed text-muted"
      >
        Built and maintained by Mustafa Masoud, learning DevOps in public.
      </p>

      <ul class="flex flex-wrap items-center gap-x-3 gap-y-2">
        <li>
          <a
            href="https://github.com/mustafammasoud"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 rounded-full bg-surface-2 px-3 py-1.5 text-sm text-muted transition-colors hover:text-text focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-bg motion-reduce:transition-none"
            lang="en"
          >
            <SocialIcon name="github" class="h-5 w-5 shrink-0" />
            <span>GitHub</span>
          </a>
        </li>
        <li>
          <a
            href="https://www.linkedin.com/in/mustafammasoud/"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 rounded-full bg-surface-2 px-3 py-1.5 text-sm text-muted transition-colors hover:text-text focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-bg motion-reduce:transition-none"
            lang="en"
          >
            <SocialIcon name="linkedin" class="h-5 w-5 shrink-0" />
            <span>LinkedIn</span>
          </a>
        </li>
        <li>
          <a
            href="mailto:masoudmustafa90@gmail.com"
            class="inline-flex items-center gap-1.5 rounded-full bg-surface-2 px-3 py-1.5 text-sm text-muted transition-colors hover:text-text focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-bg motion-reduce:transition-none"
            lang="en"
          >
            <SocialIcon name="mail" class="h-5 w-5 shrink-0" />
            <span>Email</span>
          </a>
        </li>
      </ul>
    </div>
  </footer>
</BaseLayout>
