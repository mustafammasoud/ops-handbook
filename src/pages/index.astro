---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import ArrowButton from '../components/ArrowButton.astro';
import CategoryCard from '../components/CategoryCard.astro';
import CategoryIcon from '../components/CategoryIcon.astro';
import SocialIcon from '../components/SocialIcon.astro';
import {
  categories,
  type CategoryStatus,
} from '../data/categories';
import {
  articleCount,
  docCategory,
  docPath,
  sortedDocs,
} from '../utils/docs';

/**
 * The homepage shows a curated subset of the documentation areas;
 * /docs keeps listing all of them. Metadata stays in `categories` —
 * this is only a selection of ids, in display order. Fundamentals is
 * intentionally omitted (the Start Here section already covers it).
 */
const HOMEPAGE_AREA_IDS = [
  'container-orchestration',
  'networking',
  'version-control',
  'operating-systems',
];
const homepageAreas = HOMEPAGE_AREA_IDS.flatMap((id) => {
  const category = categories.find((item) => item.id === id);
  return category ? [category] : [];
});

const docs = sortedDocs(await getCollection('docs', ({ data }) => !data.draft));

const counts = new Map<string, number>();
for (const doc of docs) {
  const cat = docCategory(doc);
  counts.set(cat, (counts.get(cat) ?? 0) + 1);
}

// Fundamentals learning sequence: 9 articles in canonical order
const fundamentalsDocs = docs.filter(
  (doc) => docCategory(doc) === 'devops-fundamentals',
);

// Start Here: 3 curated fundamentals articles, selected by id (not index).
// A missing id is skipped gracefully — the section still builds.
const START_HERE_IDS = [
  'devops-fundamentals/what-is-devops',
  'devops-fundamentals/why-devops',
  'devops-fundamentals/ci-cd-fundamentals',
];
const startHereDocs = START_HERE_IDS.flatMap((id) => {
  const doc = docs.find((d) => d.id === id);
  return doc ? [doc] : [];
});

// Primary CTA: begin with DevOps Fundamentals when it has content, else the first
// available topic.
const primaryTarget = fundamentalsDocs[0] ?? docs[0];

// Handbook statistics (dynamically derived)
const totalArticles = docs.length;

// Coverage & Roadmap: per-area status. A manual `status` override in
// categories.ts wins; otherwise it is derived from the article count.
const areaRows = categories.map((category) => {
  const count = counts.get(category.id) ?? 0;
  const status: CategoryStatus =
    category.status ?? (count > 0 ? 'published' : 'planned');
  return { category, count, status };
});

// Display order: Published → In progress → Planned, each in canonical order.
const STATUS_ORDER: Record<CategoryStatus, number> = {
  published: 0,
  'in-progress': 1,
  planned: 2,
};
const groupedAreas = [...areaRows].sort(
  (a, b) =>
    STATUS_ORDER[a.status] - STATUS_ORDER[b.status] ||
    a.category.order - b.category.order,
);

// Stats row — count-derived only (not affected by manual overrides).
const publishedAreaCount = areaRows.filter((row) => row.count > 0).length;
const plannedAreaCount = areaRows.filter((row) => row.count === 0).length;

// Badge styling per status. Always rendered together with a text label so
// status is never conveyed by color alone.
const STATUS_BADGES: Record<CategoryStatus, { label: string; cls: string }> = {
  published: {
    label: 'Published',
    cls: 'border-border-light bg-accent-soft text-accent-ink',
  },
  'in-progress': {
    label: 'In progress',
    cls: 'border-warning-border bg-warning-bg text-warning-fg',
  },
  planned: {
    label: 'Planned',
    cls: 'border-border-light bg-surface-2 text-muted',
  },
};

// Ecosystem strip: communicates the infrastructure toolchain, LTR like code.
const ecosystem = [
  { icon: 'terminal' as const, label: 'Linux' },
  { icon: 'cube' as const, label: 'Docker' },
  { icon: 'wheel' as const, label: 'Kubernetes' },
  { icon: 'modules' as const, label: 'Terraform' },
  { icon: 'cloud' as const, label: 'Cloud' },
  { icon: 'cycle' as const, label: 'CI/CD' },
];
---

<BaseLayout
  title="Ops Handbook — DevOps Knowledge Base"
  description="A practical DevOps knowledge base covering fundamentals, Linux, containers, Kubernetes, CI/CD, cloud, infrastructure, and production operations."
  hideFooter={true}
>
  <Header />

  <main id="main" class="mx-auto w-full max-w-screen-2xl px-4">
    <!-- Hero -->
    <section class="max-w-2xl pt-14 pb-12 sm:pt-20">
      <h1 class="text-3xl font-semibold leading-tight tracking-tight sm:text-4xl">
        Ops Handbook
      </h1>

      <p
        class="mt-5 text-xl font-medium leading-snug text-text text-balance"
      >
        Your structured DevOps knowledge base — from fundamentals to production.
      </p>

      <p class="mt-3 leading-relaxed text-muted">
        Documentation, hands-on labs, diagrams, and command references — all stored as
        Markdown files in the repository, built for long reading sessions and repeated
        reference.
      </p>

      <div class="mt-7 flex flex-wrap items-center gap-x-5 gap-y-3">
        {
          primaryTarget && (
            <a
              href={docPath(primaryTarget.id)}
              class="rounded-full bg-accent-fill px-5 py-2.5 text-sm font-medium text-accent-contrast transition-opacity hover:opacity-90"
            >
              Start with the fundamentals
            </a>
          )
        }
        <ArrowButton href="/docs" label="Browse the documentation" />
      </div>

      <!-- Technical ecosystem visual (monochrome, no stock images) -->
      <ul
        class="mt-10 flex flex-wrap items-center gap-x-2 gap-y-3 text-muted"
        dir="ltr"
        aria-label="Platform technologies"
      >
        {
          ecosystem.map((item, index) => (
            <li class="flex items-center gap-2">
              {index > 0 && (
                <svg
                  class="h-4 w-4 shrink-0 text-border"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="M5 12h14"></path>
                  <path d="m12 5 7 7-7 7"></path>
                </svg>
              )}
              <span class="flex items-center gap-1.5 rounded-full border border-border bg-surface px-3 py-1.5">
                <CategoryIcon name={item.icon} class="h-5 w-5" />
                <span class="text-xs font-medium tracking-wide" lang="en">
                  {item.label}
                </span>
              </span>
            </li>
          ))
        }
      </ul>
    </section>

    <!-- Start Here: Fundamentals Learning Sequence -->
    {
      startHereDocs.length > 0 && (
        <section
          class="border-t border-border py-12"
          aria-labelledby="start-here-heading"
        >
          <div class="mb-6 flex flex-wrap items-center justify-between gap-4">
            <div>
              <h2
                id="start-here-heading"
                class="text-xs font-semibold uppercase tracking-wider text-muted"
              >
                Start Here
              </h2>
              <p class="mt-1 text-lg font-semibold tracking-tight text-text sm:text-xl">
                New to DevOps? Start with the Fundamentals
              </p>
            </div>
            <ArrowButton
              href="/docs/devops-fundamentals"
              label={`View all ${fundamentalsDocs.length} fundamentals`}
            />
          </div>

          <ol class="grid gap-x-8 border-b border-border lg:grid-cols-3">
            {startHereDocs.map((doc, index) => (
              <li class="border-t border-border">
                <a
                  href={docPath(doc.id)}
                  class="group flex items-baseline gap-3.5 py-4 transition-colors hover:text-accent-ink"
                >
                  <span class="shrink-0 font-mono text-xs font-semibold text-muted tabular-nums group-hover:text-accent-ink">
                    {String(index + 1).padStart(2, '0')}
                  </span>
                  <div class="min-w-0 flex-1">
                    <span class="block text-sm font-semibold tracking-tight text-text group-hover:text-accent-ink">
                      {doc.data.title}
                    </span>
                    {doc.data.description && (
                      <span class="mt-1 block text-xs leading-relaxed text-muted line-clamp-2">
                        {doc.data.description}
                      </span>
                    )}
                  </div>
                </a>
              </li>
            ))}
          </ol>
        </section>
      )
    }

    <!-- Documentation areas: editorial index rows -->
    <section class="border-t border-border py-12" aria-labelledby="areas-heading">
      <div class="mb-4 flex flex-wrap items-center justify-between gap-4">
        <h2 id="areas-heading" class="text-lg font-semibold">
          Documentation areas
        </h2>
        <ArrowButton href="/docs" label="View all" />
      </div>

      <ul class="grid border-b border-border sm:grid-cols-2 sm:gap-x-12">
        {
          homepageAreas.map((category) => (
            <CategoryCard category={category} count={counts.get(category.id) ?? 0} />
          ))
        }
      </ul>
    </section>

    <!-- Coverage & Roadmap -->
    <section
      class="border-t border-border py-12"
      aria-labelledby="coverage-heading"
    >
      <div class="mb-6">
        <h2 id="coverage-heading" class="text-lg font-semibold">
          Coverage &amp; Roadmap
        </h2>
        <p class="mt-1 text-sm text-muted">
          The handbook is growing — here is where every documentation area stands.
        </p>
      </div>

      <!-- Compact stats row (all derived from the content collection) -->
      <dl class="mb-8 grid grid-cols-1 gap-3 sm:grid-cols-3">
        <div class="rounded-lg border border-border bg-surface px-4 py-3">
          <dt class="text-xs text-muted">Total articles</dt>
          <dd class="mt-0.5 text-2xl font-semibold tabular-nums text-text">
            {totalArticles}
          </dd>
        </div>
        <div class="rounded-lg border border-border bg-surface px-4 py-3">
          <dt class="text-xs text-muted">Published areas</dt>
          <dd class="mt-0.5 text-2xl font-semibold tabular-nums text-text">
            {publishedAreaCount}
          </dd>
        </div>
        <div class="rounded-lg border border-border bg-surface px-4 py-3">
          <dt class="text-xs text-muted">Planned areas</dt>
          <dd class="mt-0.5 text-2xl font-semibold tabular-nums text-text">
            {plannedAreaCount}
          </dd>
        </div>
      </dl>

      <!-- All 14 areas, grouped Published → In progress → Planned -->
      <ul class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
        {
          groupedAreas.map(({ category, count, status }) => {
            const badge = STATUS_BADGES[status];
            const quiet = status === 'planned';
            return (
              <li
                class:list={[
                  'flex items-start gap-3 rounded-lg border px-4 py-3',
                  quiet
                    ? 'border-border-light bg-transparent'
                    : 'border-border bg-surface',
                ]}
              >
                <CategoryIcon
                  name={category.icon}
                  class:list={[
                    'mt-0.5 h-5 w-5 shrink-0',
                    quiet ? 'text-muted/70' : 'text-muted',
                  ]}
                />
                <div class="min-w-0 flex-1">
                  <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
                    <span
                      class:list={[
                        'text-sm font-semibold tracking-tight',
                        quiet ? 'text-muted' : 'text-text',
                      ]}
                      lang="en"
                    >
                      {category.label}
                    </span>
                    <span
                      class:list={[
                        'rounded-full border px-2 py-0.5 text-[0.65rem] font-medium',
                        badge.cls,
                      ]}
                    >
                      {badge.label}
                    </span>
                  </div>
                  {!quiet && count > 0 && (
                    <span class="mt-1 block text-xs text-muted tabular-nums">
                      {articleCount(count)}
                    </span>
                  )}
                </div>
              </li>
            );
          })
        }
      </ul>
    </section>

  </main>

  <!-- Author attribution footer -->
  <footer
    class="border-t border-border py-8"
    aria-label="Site footer"
    style="padding-bottom: calc(2rem + env(safe-area-inset-bottom, 0px));"
  >
    <div class="mx-auto flex w-full max-w-screen-2xl flex-wrap items-center justify-between gap-x-8 gap-y-4 px-4">
      <p
        class="max-w-2xl text-sm leading-relaxed text-muted"
      >
        Built and maintained by Mustafa Masoud — a personal knowledge base for
        learning and documenting DevOps.
      </p>

      <ul class="flex flex-wrap items-center gap-x-5 gap-y-2">
        <li>
          <a
            href="https://github.com/mustafammasoud"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 text-sm text-muted transition-colors hover:text-accent-ink focus-visible:text-accent-ink"
            lang="en"
          >
            <SocialIcon name="github" class="h-5 w-5 shrink-0" />
            <span>GitHub</span>
          </a>
        </li>
        <li>
          <a
            href="https://www.linkedin.com/in/mustafammasoud/"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 text-sm text-muted transition-colors hover:text-accent-ink focus-visible:text-accent-ink"
            lang="en"
          >
            <SocialIcon name="linkedin" class="h-5 w-5 shrink-0" />
            <span>LinkedIn</span>
          </a>
        </li>
        <li>
          <a
            href="mailto:masoudmustafa90@gmail.com"
            class="inline-flex items-center gap-1.5 text-sm text-muted transition-colors hover:text-accent-ink focus-visible:text-accent-ink"
            lang="en"
          >
            <SocialIcon name="mail" class="h-5 w-5 shrink-0" />
            <span>Email</span>
          </a>
        </li>
      </ul>
    </div>
  </footer>
</BaseLayout>
