---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import CategoryIcon from '../../components/CategoryIcon.astro';
import TopicList from '../../components/TopicList.astro';
import PlannedState from '../../components/PlannedState.astro';
import {
  categories,
  getCategory,
  categoryLabel,
  canonicalCategoryId,
  toolLabel,
  levelLabel,
} from '../../data/categories';
import { docCategory, docTool, sortedDocs, topicCount } from '../../utils/docs';

export async function getStaticPaths() {
  // Every registered category gets a page (even while empty/planned),
  // plus any category id that only appears in content frontmatter —
  // including draft-only content, which never counts as published but
  // still marks the area as existing.
  const ids = new Set<string>([
    ...categories.map((category) => category.id),
    ...(await getCollection('docs')).map((doc) => docCategory(doc)),
  ]);
  return [...ids].map((category) => ({ params: { category } }));
}

const { category: rawCategoryId } = Astro.params;
const categoryId = canonicalCategoryId(rawCategoryId!);

const docs = sortedDocs(
  (await getCollection('docs', ({ data }) => !data.draft)).filter(
    (doc) => docCategory(doc) === categoryId,
  ),
);

const category = getCategory(categoryId!);
const label = categoryLabel(categoryId!);
const descriptionEn = category?.descriptionEn ?? `The ${label} section of the documentation.`;
const count = docs.length;

// Topic count copy.
const countText = topicCount(count);

// Difficulty range from the levels actually present (metadata only).
const LEVELS = ['beginner', 'intermediate', 'advanced'] as const;
const presentLevels = LEVELS.filter((level) => docs.some((doc) => doc.data.level === level));
const firstLevel = presentLevels[0];
const lastLevel = presentLevels[presentLevels.length - 1];
const levelRangeEn =
  presentLevels.length === 0
    ? null
    : presentLevels.length === 1
      ? `Level: ${levelLabel(firstLevel)}`
      : `Level: ${levelLabel(firstLevel)} → ${levelLabel(lastLevel)}`;

// Documentation is grouped by technology / tool (Area → Tool → Articles).
// Articles written directly under the area (no tool segment) are listed first.
const directEntries = docs.filter((doc) => !docTool(doc));
const byTool = new Map<string, typeof docs>();
for (const doc of docs) {
  const tool = docTool(doc);
  if (!tool) continue;
  const toolDocs = byTool.get(tool) ?? [];
  toolDocs.push(doc);
  byTool.set(tool, toolDocs);
}
const toolGroups = [...byTool.entries()].map(([toolId, entries]) => ({
  id: toolId,
  label: toolLabel(toolId),
  href: `/docs/${categoryId}/${toolId}`,
  count: entries.length,
  entries,
}));

const pageTitle = `${label} | Ops Handbook`;
---

<BaseLayout
  title={pageTitle}
  description={descriptionEn}
>
  <Header />

  <main id="main" class="mx-auto w-full max-w-screen-2xl px-4 py-8">
    <!-- Breadcrumbs -->
    <nav
      aria-label="Breadcrumb"
      class="mb-6 text-sm text-muted"
    >
      <ol class="flex flex-wrap items-center gap-1.5">
        <li>
          <a href="/" class="hover:text-accent-ink">Home</a>
        </li>
        <li aria-hidden="true">/</li>
        <li>
          <a href="/docs" class="hover:text-accent-ink">Docs</a>
        </li>
        <li aria-hidden="true">/</li>
        <li aria-current="page" class="font-medium text-text" lang="en">{label}</li>
      </ol>
    </nav>

    <!-- Category header -->
    <header class="border-b border-border pb-8">
      <div class="flex items-start gap-4">
        <span
          class="grid h-12 w-12 shrink-0 place-items-center rounded-md border border-border bg-surface text-muted"
        >
          {
            category ? (
              <CategoryIcon name={category.icon} class="h-7 w-7" />
            ) : (
              <CategoryIcon name="layers" class="h-7 w-7" />
            )
          }
        </span>
        <div class="min-w-0">
          <h1
            class="text-2xl font-semibold leading-snug tracking-tight sm:text-3xl"
            lang="en"
          >
            {label}
          </h1>
        </div>
      </div>

      <p class="mt-4 max-w-3xl leading-relaxed text-muted">
        {descriptionEn}
      </p>

      <p class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-2 text-sm text-muted">
        {
          count === 0 ? (
            <span>No topics yet</span>
          ) : (
            <span class="tabular-nums">
              {countText}
            </span>
          )
        }
        {
          levelRangeEn && (
            <>
              <span aria-hidden="true">·</span>
              <span>{levelRangeEn}</span>
            </>
          )
        }
      </p>
    </header>

    {
      count === 0 ? (
        <PlannedState name={label} />
      ) : (
        <>
          {
            toolGroups.length > 0 && (
              <section class="mt-10" aria-labelledby="tools-heading">
                <h2
                  id="tools-heading"
                  class="mb-4 text-lg font-semibold"
                >
                  Technologies &amp; Tools
                </h2>
                <ul class="flex flex-wrap gap-2">
                  {toolGroups.map((group) => (
                    <li>
                      <a
                        href={group.href}
                        class="flex items-center gap-2 rounded-full border border-border bg-surface px-3.5 py-1.5 text-sm transition-colors hover:border-accent/50 hover:text-accent-ink"
                        lang="en"
                      >
                        {group.label}
                        <span class="ltr text-xs text-muted tabular-nums">
                          {group.count}
                        </span>
                      </a>
                    </li>
                  ))}
                </ul>
              </section>
            )
          }

          <section
            class="mt-10"
            aria-labelledby="documentation-heading"
          >
            <h2
              id="documentation-heading"
              class="mb-4 text-lg font-semibold"
            >
              Documentation
            </h2>

            {
              directEntries.length > 0 && (
                <TopicList docs={directEntries} />
              )
            }

            {
              toolGroups.map((group, index) => (
                <div
                  class={
                    index === 0 && directEntries.length === 0 ? '' : 'mt-6'
                  }
                >
                  <div class="mb-2.5 flex items-baseline justify-between gap-3">
                    <h3 class="text-sm font-semibold" lang="en">
                      <a
                        href={group.href}
                        class="transition-colors hover:text-accent-ink"
                      >
                        {group.label}
                      </a>
                    </h3>
                    <span
                      class="rounded-full bg-surface-2 px-2 py-0.5 text-xs font-normal text-muted tabular-nums"
                    >
                      {group.count}
                    </span>
                  </div>
                  <TopicList docs={group.entries} />
                </div>
              ))
            }
          </section>
        </>
      )
    }
  </main>
</BaseLayout>
