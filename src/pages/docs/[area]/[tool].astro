---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import TopicList from '../../../components/TopicList.astro';
import PlannedState from '../../../components/PlannedState.astro';
import {
  categoryLabel,
  canonicalCategoryId,
  toolLabel,
} from '../../../data/categories';
import { docCategory, docTool, sortedDocs, topicCount } from '../../../utils/docs';

/**
 * Tool landing page: `/docs/<area>/<tool>` — one per (area, tool) pair that
 * exists in the content hierarchy. Derived entirely from the content
 * collection, so a new tool appears the moment its first article exists.
 *
 * Draft entries participate in routing (so a draft-only tool gets a page)
 * but never count as published: a tool with no published content
 * automatically renders the shared Planned / Coming Soon state.
 */
export async function getStaticPaths() {
  const all = await getCollection('docs');
  const publishedIds = new Set(
    (await getCollection('docs', ({ data }) => !data.draft)).map((doc) => doc.id),
  );
  const groups = new Map<string, { area: string; tool: string; docs: typeof all }>();

  for (const doc of all) {
    const tool = docTool(doc);
    if (!tool) continue;
    const area = docCategory(doc);
    const key = JSON.stringify([area, tool]);
    const group = groups.get(key) ?? { area, tool, docs: [] };
    if (publishedIds.has(doc.id)) group.docs.push(doc);
    groups.set(key, group);
  }

  return [...groups.values()].map((group) => ({
    params: { area: group.area, tool: group.tool },
    props: { docs: sortedDocs(group.docs) },
  }));
}

const { area, tool } = Astro.params;
const { docs } = Astro.props;

const areaId = canonicalCategoryId(area!);
const areaName = categoryLabel(areaId);
const toolName = toolLabel(tool!);
const count = topicCount(docs.length);
const planned = docs.length === 0;

const descriptionEn = planned
  ? `The ${toolName} section of the Ops Handbook is planned for a future release.`
  : `Documentation for ${toolName} in ${areaName} — concepts, guides, and practical references from the Ops Handbook.`;

const pageTitle = `${toolName} | Ops Handbook`;
---

<BaseLayout
  title={pageTitle}
  description={descriptionEn}
>
  <Header />

  <main id="main" class="mx-auto w-full max-w-screen-2xl px-4 py-8">
    <!-- Breadcrumbs: Home / Docs / Area / Tool -->
    <nav
      aria-label="Breadcrumb"
      class="mb-6 text-sm text-muted"
    >
      <ol class="flex flex-wrap items-center gap-1.5">
        <li>
          <a href="/" class="hover:text-accent-ink">Home</a>
        </li>
        <li aria-hidden="true">/</li>
        <li>
          <a href="/docs" class="hover:text-accent-ink">Docs</a>
        </li>
        <li aria-hidden="true">/</li>
        <li>
          <a href={`/docs/${areaId}`} class="hover:text-accent-ink">{areaName}</a>
        </li>
        <li aria-hidden="true">/</li>
        <li aria-current="page" class="font-medium text-text" lang="en">
          {toolName}
        </li>
      </ol>
    </nav>

    <header class="border-b border-border pb-8">
      <h1
        class="text-2xl font-semibold leading-snug tracking-tight sm:text-3xl"
        lang="en"
      >
        {toolName}
      </h1>

      <p class="mt-4 max-w-3xl leading-relaxed text-muted">
        {descriptionEn}
      </p>

      <p class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-2 text-sm text-muted">
        {
          planned ? (
            <span
              class="rounded-full bg-surface-2 px-2.5 py-0.5 text-xs text-muted"
              lang="en"
            >
              Planned
            </span>
          ) : (
            <span class="tabular-nums">{count}</span>
          )
        }
        <span aria-hidden="true">·</span>
        <span lang="en">{areaName}</span>
      </p>
    </header>

    {
      planned ? (
        <PlannedState name={toolName} />
      ) : (
        <section class="mt-10" aria-labelledby="topics-heading">
          <h2
            id="topics-heading"
            class="mb-4 text-lg font-semibold"
          >
            Topics
          </h2>
          <TopicList docs={docs} />
        </section>
      )
    }
  </main>
</BaseLayout>
