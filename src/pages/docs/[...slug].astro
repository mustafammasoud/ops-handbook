---
import { getCollection, render } from 'astro:content';
import DocLayout from '../../layouts/DocLayout.astro';
import Callout from '../../components/Callout.astro';
import Steps from '../../components/Steps.astro';
import Figure from '../../components/Figure.astro';
import InfoCard from '../../components/InfoCard.astro';
import CardGrid from '../../components/CardGrid.astro';
import PdfCard from '../../components/PdfCard.astro';
import PdfEmbed from '../../components/PdfEmbed.astro';
import { docSlug } from '../../utils/docs';

/**
 * MDX pages get these components automatically — authors use `<Callout>` etc.
 * without any import. Explicit local imports in a page (e.g. for Figure's
 * image assets) still work and take precedence.
 */
const mdxComponents = {
  Callout,
  Steps,
  Figure,
  InfoCard,
  CardGrid,
  PdfCard,
  PdfEmbed,
};

export async function getStaticPaths() {
  const docs = await getCollection('docs', ({ data }) => !data.draft);
  return docs.map((entry) => ({
    params: { slug: docSlug(entry.id) },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---

<DocLayout entry={entry} headings={headings}>
  <Content components={mdxComponents} />
</DocLayout>