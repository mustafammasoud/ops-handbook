---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import CategoryIcon from '../../../components/CategoryIcon.astro';
import { technologies, type Technology } from '../../../data/technologies';
import { categoryLabel } from '../../../data/categories';
import { extractQuestionCounts, aggregateTechQuestions, difficultyLabel } from '../../../utils/interview';

export async function getStaticPaths() {
  const allEntries = await getCollection('interviewQuestions', ({ data }) => !data.draft);

  return technologies
    .filter((tech) => allEntries.some((entry) => entry.data.technology === tech.id))
    .map((tech) => ({
      params: { technology: tech.id },
      props: {
        technology: tech,
        topics: allEntries
          .filter((entry) => entry.data.technology === tech.id)
          .sort((a, b) => a.data.order - b.data.order),
      },
    }));
}

interface Props {
  technology: Technology;
  topics: CollectionEntry<'interviewQuestions'>[];
}

const { technology, topics } = Astro.props;
const stats = aggregateTechQuestions(topics);

const pageTitle = `${technology.name} Interview Questions | Ops Handbook`;
const pageDescription = `Real-world ${technology.name} interview questions, scenario evaluations, detailed explanations, and pitfalls.`;
---

<BaseLayout title={pageTitle} description={pageDescription}>
  <Header />

  <main id="main" class="mx-auto w-full max-w-screen-2xl px-4 py-8 lg:py-12">
    <!-- Breadcrumbs -->
    <nav aria-label="Breadcrumb" class="mb-6 text-sm text-muted">
      <ol class="flex flex-wrap items-center gap-1.5">
        <li>
          <a href="/" class="hover:text-accent-ink transition-colors">Home</a>
        </li>
        <li aria-hidden="true">/</li>
        <li>
          <a href="/interview-questions" class="hover:text-accent-ink transition-colors">Interview Questions</a>
        </li>
        <li aria-hidden="true">/</li>
        <li aria-current="page" class="font-medium text-text">
          {technology.name}
        </li>
      </ol>
    </nav>

    <!-- Technology Hero -->
    <header class="border-b border-border pb-8">
      <div class="flex items-start gap-4 sm:items-center">
        <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl border border-border bg-surface text-accent-ink shadow-xs">
          <CategoryIcon name={technology.icon} class="h-7 w-7" />
        </div>
        <div>
          <div class="flex flex-wrap items-center gap-2">
            <span class="rounded-full border border-border bg-surface px-2.5 py-0.5 text-xs font-medium text-muted">
              {categoryLabel(technology.category)}
            </span>
            <span class="rounded-full bg-accent/15 px-2.5 py-0.5 text-xs font-semibold text-accent-ink">
              {topics.length} {topics.length === 1 ? 'Topic' : 'Topics'}
            </span>
            <span class="rounded-full border border-border bg-surface px-2.5 py-0.5 text-xs font-mono font-medium text-text">
              {stats.total} Questions
            </span>
          </div>
          <h1 class="mt-2 text-2xl font-bold tracking-tight text-text sm:text-4xl">
            {technology.name} Interview Questions
          </h1>
        </div>
      </div>
      <p class="mt-4 max-w-3xl text-base leading-relaxed text-muted sm:text-lg">
        {technology.description}
      </p>

      <!-- Overall Difficulty Stats -->
      <div class="mt-5 flex flex-wrap items-center gap-2 text-xs">
        {stats.beginner > 0 && (
          <span class="rounded-md border border-emerald-600/30 bg-emerald-500/10 px-2.5 py-1 font-medium text-emerald-700 dark:text-emerald-300">
            {stats.beginner} Beginner
          </span>
        )}
        {stats.intermediate > 0 && (
          <span class="rounded-md border border-amber-600/30 bg-amber-500/10 px-2.5 py-1 font-medium text-amber-700 dark:text-amber-300">
            {stats.intermediate} Intermediate
          </span>
        )}
        {stats.advanced > 0 && (
          <span class="rounded-md border border-rose-600/30 bg-rose-500/10 px-2.5 py-1 font-medium text-rose-700 dark:text-rose-300">
            {stats.advanced} Advanced
          </span>
        )}
      </div>
    </header>

    <!-- Topics Section -->
    <section class="mt-8" aria-labelledby="topics-heading">
      <div class="mb-6 flex items-center justify-between">
        <h2 id="topics-heading" class="text-lg font-semibold text-text">
          Interview Topics
        </h2>
        <span class="text-xs text-muted font-mono">
          Showing all {topics.length} topics
        </span>
      </div>

      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {topics.map((topicItem) => {
          const topicCounts = extractQuestionCounts(topicItem.body);
          return (
            <a
              href={`/interview-questions/${technology.id}/${topicItem.data.topic}`}
              class="group relative flex flex-col justify-between rounded-xl border border-border bg-surface p-5 transition-all hover:border-accent/50 hover:bg-surface-2 hover:shadow-xs"
            >
              <div>
                <div class="flex items-center justify-between gap-2 mb-2">
                  <span class="rounded-md bg-surface-2 px-2 py-0.5 text-xs font-mono font-medium text-muted border border-border/60">
                    Topic #{topicItem.data.order}
                  </span>
                  <span class="rounded-full bg-accent/10 px-2 py-0.5 text-xs font-mono font-semibold text-accent-ink">
                    {topicCounts.total} Q
                  </span>
                </div>

                <h3 class="text-base font-semibold text-text group-hover:text-accent-ink transition-colors">
                  {topicItem.data.title}
                </h3>

                <p class="mt-2 text-sm text-muted leading-relaxed line-clamp-3">
                  {topicItem.data.description}
                </p>

                <!-- Difficulty distribution -->
                <div class="mt-4 flex flex-wrap gap-1.5 text-[11px] font-mono">
                  {topicCounts.beginner > 0 && (
                    <span class="text-emerald-700 dark:text-emerald-400">
                      {topicCounts.beginner} {difficultyLabel('beginner', topicItem.data.language)}
                    </span>
                  )}
                  {topicCounts.intermediate > 0 && (
                    <span class="text-amber-700 dark:text-amber-400">
                      · {topicCounts.intermediate} {difficultyLabel('intermediate', topicItem.data.language)}
                    </span>
                  )}
                  {topicCounts.advanced > 0 && (
                    <span class="text-rose-700 dark:text-rose-400">
                      · {topicCounts.advanced} {difficultyLabel('advanced', topicItem.data.language)}
                    </span>
                  )}
                </div>
              </div>

              <div class="mt-5 flex items-center justify-between pt-3 border-t border-border/60 text-xs font-medium text-accent-ink">
                <span>Practice Questions</span>
                <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">&rarr;</span>
              </div>
            </a>
          );
        })}
      </div>
    </section>
  </main>
</BaseLayout>
