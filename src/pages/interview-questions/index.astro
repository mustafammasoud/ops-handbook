---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import CategoryIcon from '../../components/CategoryIcon.astro';
import { technologies } from '../../data/technologies';
import { categoryLabel } from '../../data/categories';
import { aggregateTechQuestions } from '../../utils/interview';

const allInterviewEntries = await getCollection('interviewQuestions', ({ data }) => !data.draft);

// Group entries by technology
const entriesByTech = new Map<string, typeof allInterviewEntries>();
for (const item of allInterviewEntries) {
  const techId = item.data.technology;
  const list = entriesByTech.get(techId) ?? [];
  list.push(item);
  entriesByTech.set(techId, list);
}
---

<BaseLayout
  title="Technical Interview Questions | Ops Handbook"
  description="Technical interview questions for DevOps, SRE, Linux, and Cloud Engineering: direct answers, deep technical explanations, pitfalls, and follow-up questions."
>
  <Header />

  <main id="main" class="mx-auto w-full max-w-screen-2xl px-4 py-10">
    <!-- Section Header -->
    <section class="max-w-2xl">
      <div class="mb-2 inline-flex items-center gap-2 rounded-full border border-border bg-surface px-3 py-1 text-xs font-medium text-accent-ink">
        <span>Interview Prep Pillar</span>
      </div>
      <h1 class="text-2xl font-bold tracking-tight text-text sm:text-4xl">
        Technical Interview Questions
      </h1>
      <p class="mt-3 text-base leading-relaxed text-muted sm:text-lg">
        Prepare for DevOps, SRE, and Cloud interviews with realistic technical questions, direct answers for fast mental rehearsal, detailed explanations, and common pitfalls.
      </p>
    </section>

    <!-- Technologies Grid -->
    <section class="mt-10 border-t border-border pt-8" aria-labelledby="technologies-heading">
      <h2 id="technologies-heading" class="mb-6 text-lg font-semibold text-text">
        Available Technologies
      </h2>

      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {technologies.map((tech) => {
          const techEntries = entriesByTech.get(tech.id) ?? [];
          const isAvailable = techEntries.length > 0;
          const stats = aggregateTechQuestions(techEntries);

          return isAvailable ? (
            <a
              href={`/interview-questions/${tech.id}`}
              class="group relative flex flex-col justify-between rounded-xl border border-border bg-surface p-5 transition-all hover:border-accent/50 hover:bg-surface-2 hover:shadow-xs"
            >
              <div>
                <div class="flex items-center justify-between gap-2 mb-3">
                  <div class="flex h-10 w-10 items-center justify-center rounded-lg border border-border bg-surface-2 text-accent-ink transition-transform group-hover:scale-105">
                    <CategoryIcon name={tech.icon} class="h-5 w-5" />
                  </div>
                  <div class="flex items-center gap-1.5">
                    <span class="rounded-full bg-accent/15 px-2.5 py-0.5 text-xs font-semibold text-accent-ink">
                      {techEntries.length} {techEntries.length === 1 ? 'topic' : 'topics'}
                    </span>
                    <span class="rounded-full border border-border bg-surface-2 px-2 py-0.5 text-xs font-mono font-medium text-text">
                      {stats.total}Q
                    </span>
                  </div>
                </div>

                <h3 class="text-base font-bold text-text group-hover:text-accent-ink transition-colors">
                  {tech.name}
                </h3>
                <p class="mt-1 text-xs text-muted font-medium">
                  {categoryLabel(tech.category)}
                </p>
                <p class="mt-2 text-sm text-muted leading-relaxed line-clamp-2">
                  {tech.description}
                </p>

                <!-- Difficulty mini-pills -->
                <div class="mt-3 flex flex-wrap gap-1.5 text-[11px] font-mono">
                  {stats.beginner > 0 && (
                    <span class="text-emerald-700 dark:text-emerald-400">
                      {stats.beginner} Beg
                    </span>
                  )}
                  {stats.intermediate > 0 && (
                    <span class="text-amber-700 dark:text-amber-400">
                      · {stats.intermediate} Int
                    </span>
                  )}
                  {stats.advanced > 0 && (
                    <span class="text-rose-700 dark:text-rose-400">
                      · {stats.advanced} Adv
                    </span>
                  )}
                </div>
              </div>

              <div class="mt-4 flex items-center justify-between text-xs font-semibold text-accent-ink pt-3 border-t border-border/60">
                <span>Start interview revision</span>
                <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">&rarr;</span>
              </div>
            </a>
          ) : (
            <div class="relative flex flex-col justify-between rounded-xl border border-border/60 bg-surface/40 p-5 opacity-75">
              <div>
                <div class="flex items-center justify-between gap-2 mb-3">
                  <div class="flex h-10 w-10 items-center justify-center rounded-lg border border-border/60 bg-surface-2/60 text-muted">
                    <CategoryIcon name={tech.icon} class="h-5 w-5" />
                  </div>
                  <span class="rounded-full bg-surface-2 px-2.5 py-0.5 text-xs text-muted">
                    Planned
                  </span>
                </div>

                <h3 class="text-base font-semibold text-muted">
                  {tech.name}
                </h3>
                <p class="mt-1 text-xs text-muted/80 font-medium">
                  {categoryLabel(tech.category)}
                </p>
                <p class="mt-2 text-sm text-muted/70 leading-relaxed line-clamp-2">
                  {tech.description}
                </p>
              </div>

              <div class="mt-4 flex items-center gap-1.5 text-xs text-muted pt-3 border-t border-border/40">
                <span>Interview questions in development</span>
              </div>
            </div>
          );
        })}
      </div>
    </section>
  </main>
</BaseLayout>
