---
/**
 * A cheat-sheet command table rendered from data: Command / What it does /
 * When to use it / Example. Every row gets a copy button; the script below
 * also injects one live filter bar per page that narrows rows across all
 * sections (sections without a match, and their heading, are hidden).
 *
 * Data lives entirely in the MDX file that renders this component, so adding
 * a command or a section never touches markup. Without JavaScript the table
 * stays a plain, readable table.
 */
interface CheatRow {
  /** The command exactly as it should be copied (placeholders like `<pod>` allowed). */
  command: string;
  /** What the command does. */
  does: string;
  /** When to reach for it. */
  when: string;
  /** Optional concrete example. */
  example?: string;
}

interface Props {
  rows: CheatRow[];
  /** Note shown instead of the table when `rows` is empty — say what will live here. */
  placeholder?: string;
}

const { rows, placeholder } = Astro.props;
const isEmpty = rows.length === 0;
const emptyNote =
  placeholder ?? 'Nothing added yet — commands for this section will be listed here.';
---

<div class="cheat-card" data-cheat="" data-cheat-empty={isEmpty ? '' : undefined}>
  {
    !isEmpty && (
      <div class="table-scroll cheat-scroll">
        <table class="cheat-table">
          <thead>
            <tr>
              <th scope="col">Command</th>
              <th scope="col">What it does</th>
              <th scope="col">When to use it</th>
              <th scope="col">Example</th>
            </tr>
          </thead>
          <tbody>
            {rows.map((row) => (
              <tr data-cheat-row="">
                <td class="cheat-cmd-cell">
                  <span class="cheat-cmd">
                    <code>{row.command}</code>
                    <button
                      type="button"
                      class="cheat-copy"
                      data-cheat-copy=""
                      data-copy={row.command}
                      aria-label="Copy command"
                      title="Copy command"
                    >
                      <svg
                        class="cheat-icon cheat-icon-copy"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.75"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        <rect x="9" y="9" width="11" height="11" rx="2" />
                        <path d="M5 15V5a2 2 0 0 1 2-2h10" />
                      </svg>
                      <svg
                        class="cheat-icon cheat-icon-check"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.75"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                      >
                        <path d="M4 12.5l5 5 11-11" />
                      </svg>
                    </button>
                  </span>
                </td>
                <td>{row.does}</td>
                <td>{row.when}</td>
                <td>
                  {row.example ? (
                    <code>{row.example}</code>
                  ) : (
                    <span class="cheat-dash" aria-label="No example">
                      —
                    </span>
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )
  }
  {isEmpty && <p class="cheat-empty">{emptyNote}</p>}
</div>

<style>
  .cheat-card {
    margin-block: 1.5rem;
    overflow: hidden;
    border: 1px solid var(--c-border);
    border-radius: 0.5rem;
    background-color: var(--c-surface);
    box-shadow: var(--c-shadow-card);
    padding: 1rem;
  }

  /* Inside the card the wrapper only handles overflow — no extra rhythm. */
  .cheat-scroll {
    margin-block: 0;
  }

  .cheat-table {
    min-width: 36rem;
  }

  .cheat-table th {
    white-space: nowrap;
    background-color: var(--c-surface-alt);
  }

  .cheat-table td {
    vertical-align: top;
  }

  .cheat-table tbody tr {
    transition: background-color 120ms ease;
  }

  .cheat-table tbody tr:hover {
    background-color: color-mix(in srgb, var(--c-accent) 7%, transparent);
  }

  .cheat-cmd-cell {
    min-width: 14rem;
  }

  .cheat-cmd {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
  }

  .cheat-cmd code {
    white-space: nowrap;
  }

  .cheat-dash {
    color: var(--c-muted);
  }

  .cheat-empty {
    margin: 0;
    border: 1px dashed var(--c-border);
    border-radius: 0.375rem;
    background-color: var(--c-surface-2);
    padding: 0.5rem 0.75rem;
    color: var(--c-muted);
    font-size: 0.875rem;
    line-height: 1.6;
  }

  /* Copy button — icon swaps to a check (or an error tint) with brief
     feedback; the tooltip text rides on the native title attribute. */
  .cheat-copy {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.6rem;
    height: 1.6rem;
    flex-shrink: 0;
    padding: 0;
    border: 1px solid var(--c-border);
    border-radius: 0.375rem;
    background-color: var(--c-surface-2);
    color: var(--c-muted);
    cursor: pointer;
    transition:
      border-color 140ms ease,
      color 140ms ease,
      background-color 140ms ease;
  }

  .cheat-copy:hover {
    border-color: color-mix(in srgb, var(--c-accent) 55%, var(--c-border));
    color: var(--c-text);
  }

  .cheat-icon {
    display: block;
    width: 0.9rem;
    height: 0.9rem;
  }

  .cheat-icon-check {
    display: none;
  }

  .cheat-copy.is-copied {
    border-color: color-mix(in srgb, var(--c-accent) 55%, var(--c-border));
    background-color: color-mix(in srgb, var(--c-accent) 12%, transparent);
    color: var(--c-accent-ink);
  }

  .cheat-copy.is-copied .cheat-icon-copy {
    display: none;
  }

  .cheat-copy.is-copied .cheat-icon-check {
    display: block;
  }

  .cheat-copy.is-error {
    border-color: var(--c-warning-border);
    color: var(--c-warning-fg);
  }
</style>

<style is:global>
  /* Filter bar — injected once per page by the script below, so these
     styles cannot be component-scoped. Namespaced to .cheat-filter. */
  .cheat-filter {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-block: 1.75rem 0.25rem;
  }

  .cheat-filter-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }

  .cheat-filter-input {
    flex: 1 1 14rem;
    max-width: 22rem;
    min-height: 2.25rem;
    border: 1px solid var(--c-border);
    border-radius: 0.375rem;
    background-color: var(--c-surface);
    padding: 0.375rem 0.75rem;
    color: var(--c-text);
    font-size: 0.875rem;
  }

  .cheat-filter-input::placeholder {
    color: var(--c-muted);
    opacity: 1;
  }

  .cheat-filter-status {
    font-size: 0.8125rem;
    color: var(--c-muted);
    font-variant-numeric: tabular-nums;
  }

  .cheat-filter .cheat-filter-none {
    margin: 0;
    font-size: 0.875rem;
    color: var(--c-muted);
  }
</style>

<script>
  // Cheat-sheet enhancements: one injected filter bar + delegated copy
  // buttons with brief visual feedback. Both are progressive — without
  // JavaScript the tables stay plain and readable.
  const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-cheat]'));

  if (cards.length > 0) {
    const rowsTotal = cards.reduce(
      (sum, card) => sum + card.querySelectorAll('[data-cheat-row]').length,
      0,
    );

    /** Nearest section heading (H2/H3) preceding a card, if any. */
    const headingOf = (card: HTMLElement): HTMLElement | null => {
      let node = card.previousElementSibling;
      for (let i = 0; i < 6 && node; i += 1) {
        const tag = node.tagName;
        if (tag === 'H2' || tag === 'H3') return node as HTMLElement;
        if (node.hasAttribute('data-cheat')) return null;
        node = node.previousElementSibling;
      }
      return null;
    };

    // --- Live filter bar (once per page, only when there are commands) ----
    if (rowsTotal > 0 && !document.querySelector('.cheat-filter')) {
      const bar = document.createElement('div');
      bar.className = 'cheat-filter';
      bar.setAttribute('lang', 'en');
      bar.setAttribute('dir', 'ltr');
      bar.setAttribute('role', 'search');
      bar.innerHTML = `
        <div class="cheat-filter-row">
          <input class="cheat-filter-input" type="search" placeholder="Filter commands…" aria-label="Filter commands" autocomplete="off" spellcheck="false">
          <span class="cheat-filter-status" role="status" aria-live="polite"></span>
        </div>
        <p class="cheat-filter-none" hidden></p>`;

      const first = cards[0];
      const anchor = headingOf(first);
      const container = first.closest('article') ?? first.parentElement;
      if (anchor) anchor.before(bar);
      else container?.prepend(bar);

      const input = bar.querySelector<HTMLInputElement>('.cheat-filter-input')!;
      const status = bar.querySelector<HTMLElement>('.cheat-filter-status')!;
      const none = bar.querySelector<HTMLElement>('.cheat-filter-none')!;

      const applyFilter = (): void => {
        const raw = input.value;
        const query = raw.trim().toLowerCase();
        let shown = 0;

        for (const card of cards) {
          if (card.hasAttribute('data-cheat-empty')) continue;
          const rows = card.querySelectorAll<HTMLElement>('[data-cheat-row]');
          let visible = 0;
          for (const row of rows) {
            const match =
              query === '' || (row.textContent ?? '').toLowerCase().includes(query);
            row.hidden = !match;
            if (match) visible += 1;
          }
          shown += visible;

          // Hide the section entirely (card + its heading) while nothing
          // in it matches; placeholders stay visible as orientation.
          const hide = query !== '' && visible === 0;
          const heading = headingOf(card);
          card.style.display = hide ? 'none' : '';
          if (heading) heading.style.display = hide ? 'none' : '';
        }

        status.textContent =
          query === '' ? `${rowsTotal} commands` : `${shown} of ${rowsTotal} commands`;
        none.hidden = query === '' || shown > 0;
        if (!none.hidden) none.textContent = `No commands match “${raw.trim()}”.`;
      };

      input.addEventListener('input', applyFilter);
      applyFilter();
    }

    // --- Copy buttons (delegated once) ------------------------------------
    const timers = new WeakMap<HTMLElement, number>();

    document.addEventListener('click', async (event) => {
      if (!(event.target instanceof Element)) return;
      const button = event.target.closest<HTMLElement>('[data-cheat-copy]');
      if (!button) return;

      let ok = false;
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? '');
        ok = true;
      } catch {
        ok = false;
      }

      window.clearTimeout(timers.get(button));
      button.classList.toggle('is-copied', ok);
      button.classList.toggle('is-error', !ok);
      const label = ok ? 'Copied' : 'Copy failed';
      button.setAttribute('aria-label', label);
      button.setAttribute('title', label);
      timers.set(
        button,
        window.setTimeout(() => {
          button.classList.remove('is-copied', 'is-error');
          button.setAttribute('aria-label', 'Copy command');
          button.setAttribute('title', 'Copy command');
        }, 1600),
      );
    });
  }
</script>
