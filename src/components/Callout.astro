---
import CategoryIcon from './CategoryIcon.astro';
import type { CategoryIconName } from '../data/categories';

type CalloutType = 'note' | 'tip' | 'warning' | 'lab';

interface Props {
  type?: CalloutType;
  /** Optional custom heading. Defaults to a fixed English label per type. */
  title?: string;
}

const { type = 'note', title } = Astro.props;

/** Default titles per callout type. */
const defaultTitles: Record<CalloutType, string> = {
  note: 'Note',
  tip: 'Tip',
  warning: 'Warning',
  lab: 'Lab',
};

const styles: Record<CalloutType, { bg: string; border: string; fg: string }> = {
  note: { bg: 'bg-note-bg', border: 'border-note-border', fg: 'text-note-fg' },
  tip: { bg: 'bg-tip-bg', border: 'border-tip-border', fg: 'text-tip-fg' },
  warning: { bg: 'bg-warning-bg', border: 'border-warning-border', fg: 'text-warning-fg' },
  lab: { bg: 'bg-lab-bg', border: 'border-lab-border', fg: 'text-lab-fg' },
};

const s = styles[type];

const calloutIcon: Record<CalloutType, CategoryIconName> = {
  note: 'layers',
  tip: 'wrench',
  warning: 'shield',
  lab: 'terminal',
};
---

<aside class:list={['my-6 rounded-sm border-s-[3px] px-4 py-3', s.bg, s.border]} role="note">
  <div class="flex items-start gap-2.5">
    <span class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-md border border-border/60 bg-surface-2/60 text-accent-ink shadow-sm" aria-hidden="true">
      <CategoryIcon name={calloutIcon[type]} class="h-3.5 w-3.5" />
    </span>
    <p
      class:list={['mb-1 text-sm font-semibold', s.fg]}
    >
      {title ?? defaultTitles[type]}
    </p>
  </div>
  <div class="text-[0.9375rem] leading-relaxed [&>*:first-child]:mt-0 [&>*:last-child]:mb-0">
    <slot />
  </div>
</aside>
