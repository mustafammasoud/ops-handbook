---
import type { CategoryIconName } from '../data/categories';

interface Props {
  name: CategoryIconName;
  class?: string;
}

const { name, class: className = 'h-6 w-6' } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {
    name === 'layers' && (
      <>
        <path d="M12 3 21 7.5 12 12 3 7.5Z" />
        <path d="m3 12 9 4.5L21 12" />
        <path d="m3 16.5 9 4.5 9-4.5" />
      </>
    )
  }
  {
    name === 'terminal' && (
      <>
        <rect x="3" y="4" width="18" height="16" rx="2" />
        <path d="m7 9 3 3-3 3" />
        <path d="M13 15h4" />
      </>
    )
  }
  {
    name === 'network' && (
      <>
        <circle cx="12" cy="5" r="2.2" />
        <circle cx="5" cy="18" r="2.2" />
        <circle cx="19" cy="18" r="2.2" />
        <path d="M11 6.9 6 16.1" />
        <path d="m13 6.9 5 9.2" />
        <path d="M7.2 18h9.6" />
      </>
    )
  }
  {
    name === 'branch' && (
      <>
        <path d="M6 3v12" />
        <circle cx="18" cy="6" r="3" />
        <circle cx="6" cy="18" r="3" />
        <path d="M18 9a9 9 0 0 1-9 9" />
      </>
    )
  }
  {
    name === 'cube' && (
      <>
        <path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z" />
        <path d="m3.3 7 8.7 5 8.7-5" />
        <path d="M12 22V12" />
      </>
    )
  }
  {
    name === 'cycle' && (
      <>
        <path d="M21 12a9 9 0 1 1-9-9c2.5 0 4.8 1 6.5 2.6L21 8" />
        <path d="M21 3v5h-5" />
      </>
    )
  }
  {
    name === 'wheel' && (
      <>
        <circle cx="12" cy="12" r="8.25" />
        <circle cx="12" cy="12" r="2.5" />
        <path d="M16 12h3.8" />
        <path d="M14 15.5 15.9 18.8" />
        <path d="M10 15.5 8.1 18.8" />
        <path d="M8 12H4.2" />
        <path d="M10 8.5 8.1 5.2" />
        <path d="M14 8.5 15.9 5.2" />
      </>
    )
  }
  {
    name === 'cloud' && <path d="M17.5 19H9a7 7 0 1 1 6.71-9h1.79a4.5 4.5 0 1 1 0 9Z" />
  }
  {
    name === 'modules' && (
      <>
        <path d="M4 5.2 9 8.1v5.6L4 10.8Z" />
        <path d="M4 12.4 9 15.3v5.6L4 18Z" />
        <path d="M10 8.6 15 11.5v5.6L10 14.2Z" />
      </>
    )
  }
  {
    name === 'pulse' && <path d="M22 12h-4l-3 9L9 3l-3 9H2" />
  }
  {
    name === 'shield' && (
      <>
        <path d="M12 22s8-4 8-10V5.5L12 2 4 5.5V12c0 6 8 10 8 10Z" />
        <circle cx="12" cy="11" r="1.6" />
      </>
    )
  }
  {
    name === 'wrench' && (
      <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76Z" />
    )
  }
  {
    name === 'code' && (
      <>
        <polyline points="16 18 22 12 16 6" />
        <polyline points="8 6 2 12 8 18" />
      </>
    )
  }
  {
    name === 'sliders' && (
      <>
        <line x1="4" y1="21" x2="4" y2="14" />
        <line x1="4" y1="10" x2="4" y2="3" />
        <line x1="12" y1="21" x2="12" y2="12" />
        <line x1="12" y1="8" x2="12" y2="3" />
        <line x1="20" y1="21" x2="20" y2="16" />
        <line x1="20" y1="12" x2="20" y2="3" />
        <line x1="1" y1="14" x2="7" y2="14" />
        <line x1="9" y1="8" x2="15" y2="8" />
        <line x1="17" y1="16" x2="23" y2="16" />
      </>
    )
  }
  {
    name === 'database' && (
      <>
        <ellipse cx="12" cy="5.5" rx="8" ry="3" />
        <path d="M4 5.5v13c0 1.66 3.58 3 8 3s8-1.34 8-3v-13" />
        <path d="M4 12c0 1.66 3.58 3 8 3s8-1.34 8-3" />
      </>
    )
  }
  {
    name === 'git-merge' && (
      <>
        <circle cx="6" cy="6" r="2.2" />
        <circle cx="6" cy="18" r="2.2" />
        <circle cx="18" cy="12" r="2.2" />
        <path d="M6 8.2v7.6" />
        <path d="M6 12h9.8" />
      </>
    )
  }
  {
    name === 'git-pull-request' && (
      <>
        <circle cx="6" cy="6" r="2.2" />
        <circle cx="6" cy="18" r="2.2" />
        <circle cx="18" cy="18" r="2.2" />
        <path d="M6 8.2v7.6" />
        <path d="M8.2 18h7.6" />
        <path d="M18 15.8V10a4 4 0 0 0-4-4H9.5" />
      </>
    )
  }
  {
    name === 'flag' && (
      <>
        <path d="M4 21V4" />
        <path d="M4 4h13l-2.5 4L17 12H4" />
      </>
    )
  }
  {
    name === 'tag' && (
      <>
        <path d="M20.59 13.41 12 22l-8.59-8.59A2 2 0 0 1 3 12V4a1 1 0 0 1 1-1h8a2 2 0 0 1 1.41.59l7.18 7.18a2 2 0 0 1 0 2.83Z" />
        <circle cx="7.5" cy="7.5" r="1.2" />
      </>
    )
  }
</svg>
