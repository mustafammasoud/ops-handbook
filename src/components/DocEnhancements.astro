---
/**
 * Client-side reading enhancements for documentation content:
 * heading anchor links, code copy buttons and an image lightbox.
 * Included by DocLayout and the components preview page.
 */
---

<dialog id="image-viewer" class="lightbox" aria-label="View image">
  <img id="image-viewer-img" alt="" />
  <button type="button" class="lightbox-close" aria-label="Close">
    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      class="h-5 w-5"
    >
      <path d="M18 6 6 18M6 6l12 12"></path>
    </svg>
  </button>
</dialog>

<script>
  // Strings for elements created at runtime (English UI).
  const strings = {
    permalink: 'Permanent link to this section',
    copy: 'Copy',
    copyCode: 'Copy code',
    copied: 'Copied',
    copyFailed: 'Copy failed',
    zoom: (alt: string) => `Zoom image: ${alt || 'no description'}`,
  };

  // Heading anchors ----------------------------------------------------
  for (const heading of document.querySelectorAll<HTMLElement>('.prose :is(h2, h3, h4)[id]')) {
    if (heading.querySelector('.heading-anchor')) continue;
    const anchor = document.createElement('a');
    anchor.className = 'heading-anchor';
    anchor.href = `#${heading.id}`;
    anchor.textContent = '#';
    anchor.setAttribute('aria-label', strings.permalink);
    heading.append(anchor);
  }

  // Code copy buttons + language badge ---------------------------------
  for (const pre of document.querySelectorAll<HTMLElement>('pre.astro-code')) {
    const language = pre.dataset.language;
    if (language === 'mermaid') continue;

    // Header row above the code: language label at the start, Copy button
    // at the end. A real flex row keeps them from ever overlapping.
    let head = pre.querySelector<HTMLElement>('.code-head');
    if (!head) {
      head = document.createElement('div');
      head.className = 'code-head';
      pre.insertBefore(head, pre.firstChild);
    }

    if (language && !head.querySelector('.code-lang')) {
      const badge = document.createElement('span');
      badge.className = 'code-lang';
      badge.textContent = language;
      head.append(badge);
    }

    if (head.querySelector('.code-copy')) continue;
    const button = document.createElement('button');
    button.type = 'button';
    button.className = 'code-copy';
    button.dataset.tip = strings.copy;
    button.setAttribute('aria-label', strings.copyCode);
    // Inline copy/check icons — no icon dependency. CSS swaps them via
    // the button's .is-copied state.
    button.innerHTML = `
      <svg class="copy-icon copy-icon-copy" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="9" y="9" width="13" height="13" rx="2"></rect>
        <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
      </svg>
      <svg class="copy-icon copy-icon-check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M20 6 9 17l-5-5"></path>
      </svg>`;
    let resetTimer = 0;
    button.addEventListener('click', async () => {
      const code = pre.querySelector('code')?.textContent ?? '';
      let success = true;
      try {
        await navigator.clipboard.writeText(code);
      } catch {
        success = false;
      }
      button.classList.toggle('is-copied', success);
      button.classList.add('show-tip');
      button.dataset.tip = success ? strings.copied : strings.copyFailed;
      button.setAttribute('aria-label', success ? strings.copied : strings.copyFailed);
      window.clearTimeout(resetTimer);
      resetTimer = window.setTimeout(() => {
        button.classList.remove('is-copied', 'show-tip');
        button.dataset.tip = strings.copy;
        button.setAttribute('aria-label', strings.copyCode);
      }, 2000);
    });
    head.append(button);
  }

  // Responsive tables: wrap in a horizontal scroll container ------------
  for (const table of document.querySelectorAll<HTMLElement>('.prose table')) {
    if (table.parentElement?.classList.contains('table-scroll')) continue;
    const scroll = document.createElement('div');
    scroll.className = 'table-scroll';
    table.replaceWith(scroll);
    scroll.append(table);
  }

  // Image lightbox -----------------------------------------------------
  const viewer = document.getElementById('image-viewer') as HTMLDialogElement | null;
  const viewerImage = document.getElementById('image-viewer-img') as HTMLImageElement | null;
  const closeButton = viewer?.querySelector('.lightbox-close');

  if (viewer && viewerImage && closeButton) {
    for (const image of document.querySelectorAll<HTMLImageElement>('.prose img')) {
      image.classList.add('zoomable');
      image.tabIndex = 0;
      image.setAttribute('role', 'button');
      image.setAttribute('aria-label', strings.zoom(image.alt));
      const open = () => {
        viewerImage.src = image.currentSrc || image.src;
        viewerImage.alt = image.alt;
        viewer.showModal();
      };
      image.addEventListener('click', open);
      image.addEventListener('keydown', (event) => {
        if (event.key === 'Enter' || event.key === ' ') {
          event.preventDefault();
          open();
        }
      });
    }

    closeButton.addEventListener('click', () => viewer.close());
    viewer.addEventListener('click', (event) => {
      if (event.target === viewer) viewer.close();
    });
  }
</script>
