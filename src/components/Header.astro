---
import ThemeToggle from './ThemeToggle.astro';
import Search from './Search.astro';
import SocialIcon from './SocialIcon.astro';

/** Highlight the "Docs" nav link on documentation routes. */
const isDocs = Astro.url.pathname.startsWith('/docs');
---

<header
  data-site-header
  class="sticky top-0 z-40 border-b border-border backdrop-blur transition-shadow duration-200 motion-reduce:transition-none"
>
  <div class="mx-auto flex h-14 max-w-screen-2xl items-center gap-3 px-4 sm:gap-4">
    <!-- Left: logo + primary nav -->
    <div class="flex min-w-0 flex-1 items-center gap-3">
      <a
        href="/"
        class="flex shrink-0 items-center gap-2.5 font-semibold tracking-tight transition-opacity hover:opacity-75 motion-reduce:transition-none"
        dir="ltr"
      >
        <!-- Atlas Plate mark: monochrome frame + route, accent terminus node. -->
        <svg class="h-7 w-7" viewBox="0 0 32 32" fill="none" aria-hidden="true">
          <rect
            x="3.25"
            y="3.25"
            width="25.5"
            height="25.5"
            rx="6.5"
            stroke="currentColor"
            stroke-width="2.5"
          />
          <path
            d="M10 23.5V16Q10 14 12 14H18.75"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
          <circle cx="21.5" cy="14" r="3" class="fill-accent" />
        </svg>
        <span class="hidden sm:inline">Ops Handbook</span>
      </a>

      <nav aria-label="Main navigation" class="hidden sm:block">
        <a
          href="/docs"
          aria-current={isDocs ? 'page' : undefined}
          class="docs-link nav-link rounded-full px-3 py-1.5 text-sm font-medium transition-colors"
        >
          Docs
        </a>
      </nav>
    </div>

    <!-- Center: search — grows with the viewport, capped, centered between
         the left and right regions (equal flex on both sides). -->
    <div class="mx-auto flex min-w-0 flex-1 justify-center max-w-[32rem] sm:block">
      <Search />
    </div>

    <!-- Right: actions -->
    <div class="flex flex-1 items-center justify-end gap-2">
      <a
        href="https://github.com/mustafammasoud/ops-handbook"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub repository"
        title="GitHub repository"
        class="inline-flex h-10 w-10 items-center justify-center rounded-xl text-muted transition-colors hover:bg-surface-2 hover:text-text focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-bg motion-reduce:transition-none"
      >
        <SocialIcon name="github" class="h-5 w-5 shrink-0" />
      </a>
      <ThemeToggle />
    </div>
  </div>
</header>

<style>
  /* Navbar surface: semi-transparent page background so the backdrop blur
     reads through, plus a soft shadow that only appears once scrolled. */
  header {
    background-color: color-mix(in srgb, var(--c-bg) 80%, transparent);
  }

  header[data-scrolled] {
    box-shadow:
      0 1px 2px color-mix(in srgb, var(--c-text) 8%, transparent),
      0 10px 28px color-mix(in srgb, var(--c-text) 6%, transparent);
  }

  /* Docs pill: accent-tinted active fill replaces the global underline. */
  .docs-link[aria-current='page'] {
    background-color: var(--c-accent-soft);
  }

  .docs-link[aria-current='page']::after {
    display: none;
  }
</style>

<script>
  // Adds [data-scrolled] to the header after a few pixels of scroll so the
  // soft shadow fades in — rAF-throttled, passive, no dependency.
  const header = document.querySelector<HTMLElement>('[data-site-header]');

  if (header) {
    let ticking = false;

    const update = (): void => {
      header.toggleAttribute('data-scrolled', window.scrollY > 4);
      ticking = false;
    };

    const onScroll = (): void => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    };

    // Sync the initial state (e.g. restored scroll position on reload).
    update();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener(
      'pagehide',
      () => window.removeEventListener('scroll', onScroll),
      { once: true },
    );
  }
</script>
