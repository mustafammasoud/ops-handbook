---
import ThemeToggle from './ThemeToggle.astro';
import Search from './Search.astro';
import SocialIcon from './SocialIcon.astro';

const pathname = Astro.url.pathname;
const isDocs = pathname.startsWith('/docs');
const isCheatSheets = pathname.startsWith('/cheat-sheets');
const isInterview = pathname.startsWith('/interview-questions');
---

<header
  data-site-header
  class="sticky top-0 z-40 border-b border-border backdrop-blur transition-shadow duration-200 motion-reduce:transition-none"
>
  <div class="mx-auto flex h-14 max-w-screen-2xl items-center gap-3 px-4 sm:gap-4">
    <!-- Left: logo + primary nav -->
    <div class="flex min-w-0 items-center gap-3 lg:gap-5">
      <a
        href="/"
        class="flex shrink-0 items-center gap-2.5 font-semibold tracking-tight transition-opacity hover:opacity-75 motion-reduce:transition-none"
        dir="ltr"
      >
        <!-- Atlas Plate mark: monochrome frame + route, accent terminus node. -->
        <svg class="h-7 w-7" viewBox="0 0 32 32" fill="none" aria-hidden="true">
          <rect
            x="3.25"
            y="3.25"
            width="25.5"
            height="25.5"
            rx="6.5"
            stroke="currentColor"
            stroke-width="2.5"
          />
          <path
            d="M10 23.5V16Q10 14 12 14H18.75"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
          />
          <circle cx="21.5" cy="14" r="3" class="fill-accent" />
        </svg>
        <span class="hidden sm:inline">Ops Handbook</span>
      </a>

      <!-- Desktop Primary Nav: 3 Core Pillars -->
      <nav aria-label="Main navigation" class="hidden md:flex items-center gap-1">
        <a
          href="/docs"
          aria-current={isDocs ? 'page' : undefined}
          class:list={[
            'nav-pill rounded-full px-3 py-1.5 text-sm font-medium transition-colors',
            isDocs
              ? 'bg-accent/15 text-accent-ink font-semibold'
              : 'text-muted hover:bg-surface-2 hover:text-text',
          ]}
        >
          Docs
        </a>
        <a
          href="/cheat-sheets"
          aria-current={isCheatSheets ? 'page' : undefined}
          class:list={[
            'nav-pill rounded-full px-3 py-1.5 text-sm font-medium transition-colors whitespace-nowrap',
            isCheatSheets
              ? 'bg-accent/15 text-accent-ink font-semibold'
              : 'text-muted hover:bg-surface-2 hover:text-text',
          ]}
        >
          Cheat Sheets
        </a>
        <a
          href="/interview-questions"
          aria-current={isInterview ? 'page' : undefined}
          class:list={[
            'nav-pill rounded-full px-3 py-1.5 text-sm font-medium transition-colors whitespace-nowrap',
            isInterview
              ? 'bg-accent/15 text-accent-ink font-semibold'
              : 'text-muted hover:bg-surface-2 hover:text-text',
          ]}
        >
          Interview Questions
        </a>
      </nav>
    </div>

    <!-- Center: search — grows with the viewport, capped, centered -->
    <div class="mx-auto flex min-w-0 flex-1 justify-center max-w-[28rem] sm:block">
      <Search />
    </div>

    <!-- Right: actions -->
    <div class="flex items-center justify-end gap-2 shrink-0">
      <a
        href="https://github.com/mustafammasoud/ops-handbook"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub repository"
        title="GitHub repository"
        class="inline-flex h-10 w-10 items-center justify-center rounded-xl text-muted transition-colors hover:bg-surface-2 hover:text-text focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-bg motion-reduce:transition-none"
      >
        <SocialIcon name="github" class="h-5 w-5 shrink-0" />
      </a>
      <ThemeToggle />
    </div>
  </div>

  <!-- Mobile Section Nav Strip: 1-tap accessible navigation without modal friction -->
  <div class="border-t border-border/60 bg-surface/80 px-3 py-1.5 md:hidden">
    <nav aria-label="Mobile section navigation" class="flex items-center justify-between gap-1 text-xs">
      <a
        href="/docs"
        aria-current={isDocs ? 'page' : undefined}
        class:list={[
          'flex-1 text-center rounded-lg py-1.5 px-2 font-medium transition-colors',
          isDocs
            ? 'bg-accent/15 text-accent-ink font-semibold'
            : 'text-muted hover:bg-surface-2 hover:text-text',
        ]}
      >
        Docs
      </a>
      <a
        href="/cheat-sheets"
        aria-current={isCheatSheets ? 'page' : undefined}
        class:list={[
          'flex-1 text-center rounded-lg py-1.5 px-2 font-medium transition-colors',
          isCheatSheets
            ? 'bg-accent/15 text-accent-ink font-semibold'
            : 'text-muted hover:bg-surface-2 hover:text-text',
        ]}
      >
        Cheat Sheets
      </a>
      <a
        href="/interview-questions"
        aria-current={isInterview ? 'page' : undefined}
        class:list={[
          'flex-1 text-center rounded-lg py-1.5 px-2 font-medium transition-colors',
          isInterview
            ? 'bg-accent/15 text-accent-ink font-semibold'
            : 'text-muted hover:bg-surface-2 hover:text-text',
        ]}
      >
        Interview Questions
      </a>
    </nav>
  </div>
</header>

<style>
  /* Navbar surface: semi-transparent page background so the backdrop blur
     reads through, plus a soft shadow that only appears once scrolled. */
  header {
    background-color: color-mix(in srgb, var(--c-bg) 80%, transparent);
  }

  header[data-scrolled] {
    box-shadow:
      0 1px 2px color-mix(in srgb, var(--c-text) 8%, transparent),
      0 10px 28px color-mix(in srgb, var(--c-text) 6%, transparent);
  }

  /* Docs pill: accent-tinted active fill replaces the global underline. */
  .docs-link[aria-current='page'] {
    background-color: var(--c-accent-soft);
  }

  .docs-link[aria-current='page']::after {
    display: none;
  }
</style>

<script>
  // Adds [data-scrolled] to the header after a few pixels of scroll so the
  // soft shadow fades in — rAF-throttled, passive, no dependency.
  const header = document.querySelector<HTMLElement>('[data-site-header]');

  if (header) {
    let ticking = false;

    const update = (): void => {
      header.toggleAttribute('data-scrolled', window.scrollY > 4);
      ticking = false;
    };

    const onScroll = (): void => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(update);
    };

    // Sync the initial state (e.g. restored scroll position on reload).
    update();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener(
      'pagehide',
      () => window.removeEventListener('scroll', onScroll),
      { once: true },
    );
  }
</script>
