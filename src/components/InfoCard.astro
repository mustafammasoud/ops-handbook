---
import CategoryIcon from './CategoryIcon.astro';
import type { CategoryIconName } from '../data/categories';

type InfoCardVariant =
  | 'concept'
  | 'comparison'
  | 'insight'
  | 'feature'
  | 'callout'
  | 'tip'
  | 'warning'
  | 'danger'
  | 'success'
  | 'summary'
  | 'command'
  | 'resource';

interface Props {
  /** Card heading, e.g. a concept or option name. */
  title: string;
  /** One or two short sentences. Omit to render a title-only card. */
  description?: string;
  /** Icon from the project's existing icon set (`CategoryIcon`). */
  icon?: CategoryIconName;
  /** Small restrained tags shown under the description. */
  tags?: string[];
  /** Optional short eyebrow label above the title. */
  eyebrow?: string;
  /**
   * Visual treatment — pick by content role, not decoration:
   * - `concept` (default): calm card for definitions and building blocks
   * - `comparison`: accent rail — one of several related options side by side
   * - `insight`: solid accent rail + tinted surface — key takeaways
   * - `feature`: feature / capability card with soft tinted surface
   * - `callout`: supplementary note information
   * - `tip`: practical recommendation
   * - `warning`: potentially problematic configuration
   * - `danger`: destructive / high-impact operations
   * - `success`: verified positive outcome
   * - `summary`: key takeaways and lesson summaries
   * - `command`: terminal / CLI command reference
   * - `resource`: external reference / documentation link
   */
  variant?: InfoCardVariant;
}

const { title, description, icon, tags, eyebrow, variant = 'concept' } = Astro.props;
const hasTags = Array.isArray(tags) && tags.length > 0;
const hasBody = Boolean(description) || Astro.slots.has('default') || hasTags || Boolean(eyebrow);

/* Variant styling — uses only existing design tokens. */
const variantConfig: Record<
  InfoCardVariant,
  { surface: string; border: string; rail?: string; textMuted?: string }
> = {
  concept: { surface: 'bg-surface', border: 'border-border' },
  comparison: { surface: 'bg-surface', border: 'border-s-accent/55', rail: 'border-s-[3px] border-s-accent/55' },
  insight: { surface: 'bg-surface-2/60', border: 'border-s-accent', rail: 'border-s-[3px] border-s-accent' },
  feature: { surface: 'bg-surface-2/30', border: 'border-border' },
  callout: { surface: 'bg-note-bg', border: 'border-note-border', textMuted: 'text-note-fg' },
  tip: { surface: 'bg-tip-bg', border: 'border-tip-border', textMuted: 'text-tip-fg' },
  warning: { surface: 'bg-warning-bg', border: 'border-warning-border', textMuted: 'text-warning-fg', rail: 'border-s-[3px] border-s-warning-border' },
  danger: { surface: 'bg-warning-bg', border: 'border-warning-border', textMuted: 'text-warning-fg', rail: 'border-s-[3px] border-s-warning-fg' },
  success: { surface: 'bg-note-bg', border: 'border-note-border', rail: 'border-s-[3px] border-s-accent' },
  summary: { surface: 'bg-surface-2/40', border: 'border-border' },
  command: { surface: 'bg-code-bg', border: 'border-code-border', textMuted: 'text-code-muted' },
  resource: { surface: 'bg-surface', border: 'border-border' },
};

const cfg = variantConfig[variant];
const railClass = cfg.rail ? cfg.rail : '';
const surfaceClass = cfg.surface;
const borderClass = cfg.border === 'border-border' ? 'border border-border' : `border ${cfg.border}`;
const mutedClass = cfg.textMuted ? cfg.textMuted : 'text-muted';
---

<div
  class:list={[
    'my-6 rounded-lg shadow-card p-4 sm:p-5 transition-shadow duration-200 hover:shadow-[0_4px_12px_rgb(45_35_20_/0.08)]',
    surfaceClass,
    borderClass,
    railClass,
  ]}
  data-variant={variant}
>
  {eyebrow && (
    <p class="eyebrow mb-2 text-[0.65rem] leading-none tracking-widest uppercase text-muted">
      {eyebrow}
    </p>
  )}
  <div class="flex items-start gap-3.5">
    {
      icon && (
        <span
          class:list={[
            'flex h-10 w-10 shrink-0 items-center justify-center rounded-xl border shadow-sm',
            variant === 'command' ? 'border-code-border bg-code-chrome-bg text-accent-ink' : 'border-border/60 bg-surface-2/70 text-accent-ink',
          ]}
        >
          <CategoryIcon name={icon} class="h-5 w-5" />
        </span>
      )
    }

    <div class:list={['min-w-0 flex-1', !hasBody && 'flex items-center']}>
      <p class="text-[1.05rem] font-semibold leading-snug text-text tracking-tight">
        {title}
      </p>
      {
        hasBody && (
          <div class="min-w-0">
            {description && (
              <p class:list={["mt-1.5 text-[0.9rem] leading-relaxed", mutedClass]}>
                {description}
              </p>
            )}
            {Astro.slots.has('default') && (
              <div class:list={["mt-3 text-[0.9rem] leading-relaxed [&>*:first-child]:mt-0 [&>*:last-child]:mb-0", mutedClass]}>
                <slot />
              </div>
            )}
            {hasTags && (
              <div class="mt-3 flex flex-wrap gap-1.5">
                {tags.map((tag) => (
                  <span
                    class:list={[
                      'rounded-full px-2.5 py-0.5 text-[0.7rem] font-medium tracking-wide',
                      variant === 'command'
                        ? 'bg-code-chrome-bg text-code-muted border border-code-border'
                        : 'bg-surface-2 text-muted border border-border/40',
                    ]}
                  >
                    {tag}
                  </span>
                ))}
              </div>
            )}
          </div>
        )
      }
    </div>
  </div>
</div>
