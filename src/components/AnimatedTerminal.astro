---
/**
 * AnimatedTerminal.astro
 *
 * A modern, smooth, interactive engineering terminal component for the Ops Handbook hero.
 * Features Starship/zsh styled prompts, live syntax highlighting, smooth variable-cadence typing,
 * soft entry animations for outputs, session tabs, copy action, and pause/play controls.
 */
---

<div
  class="terminal-wrapper relative w-full select-none"
  dir="ltr"
  role="region"
  aria-label="Interactive DevOps terminal session"
>
  <!-- Multi-layered modern ambient backdrop glow -->
  <div
    class="pointer-events-none absolute -inset-3 rounded-3xl bg-gradient-to-tr from-accent/20 via-emerald-500/10 to-accent/5 opacity-70 blur-2xl transition-opacity duration-700"
    aria-hidden="true"
  ></div>

  <!-- Terminal Window Surface -->
  <div
    class="terminal-window relative overflow-hidden rounded-2xl border border-white/[0.08] dark:border-white/[0.06] bg-[#090e0c] dark:bg-[#060a08] text-[#e3ece7] shadow-2xl shadow-black/50 transition-shadow duration-300 hover:shadow-accent/5 hover:border-white/[0.12]"
  >
    <!-- Top specular line for realistic glass sheen -->
    <div
      class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-white/20 to-transparent"
      aria-hidden="true"
    ></div>

    <!-- Terminal Header Bar (Extra blur with high saturation glassmorphism) -->
    <div
      class="terminal-navbar flex h-10.5 items-center justify-between border-b border-white/[0.07] bg-[#090e0c]/55 px-3 sm:px-4 backdrop-blur-2xl select-none"
    >
      <!-- macOS Window Traffic Lights (Darker, deep muted tones) -->
      <div class="flex items-center gap-2" aria-hidden="true">
        <span class="group relative flex h-3 w-3 items-center justify-center rounded-full bg-[#6a1c18] border border-[#852520]/60 shadow-2xs"></span>
        <span class="group relative flex h-3 w-3 items-center justify-center rounded-full bg-[#6b4b0e] border border-[#875f12]/60 shadow-2xs"></span>
        <span class="group relative flex h-3 w-3 items-center justify-center rounded-full bg-[#144722] border border-[#1d6330]/60 shadow-2xs"></span>
      </div>

      <!-- Interactive Session Tabs -->
      <div class="hidden sm:flex items-center gap-1 rounded-lg bg-black/40 p-0.5 border border-white/[0.06]">
        <button
          type="button"
          class="terminal-tab px-2.5 py-0.5 rounded-md text-[11px] font-mono transition-all duration-200"
          data-session="0"
          aria-label="k8s cluster session"
        >
          k8s
        </button>
        <button
          type="button"
          class="terminal-tab px-2.5 py-0.5 rounded-md text-[11px] font-mono transition-all duration-200"
          data-session="1"
          aria-label="knowledge hub session"
        >
          hub
        </button>
        <button
          type="button"
          class="terminal-tab px-2.5 py-0.5 rounded-md text-[11px] font-mono transition-all duration-200"
          data-session="2"
          aria-label="linux runtime session"
        >
          linux
        </button>
        <button
          type="button"
          class="terminal-tab px-2.5 py-0.5 rounded-md text-[11px] font-mono transition-all duration-200"
          data-session="3"
          aria-label="terraform iac session"
        >
          iac
        </button>
      </div>

      <!-- Right Action Controls (Live indicator + Pause + Copy) -->
      <div class="flex items-center gap-2 text-[11px] font-mono text-[#8ca397]">
        <!-- Live status pill -->
        <span class="inline-flex items-center gap-1.5 rounded-full border border-emerald-500/30 bg-emerald-500/10 px-2 py-0.5 text-[10px] font-medium text-emerald-400">
          <span class="h-1.5 w-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
          live
        </span>

        <!-- Pause / Play Button -->
        <button
          id="terminal-play-pause-btn"
          type="button"
          class="inline-flex h-7 w-7 items-center justify-center rounded-md border border-white/[0.06] bg-white/[0.03] hover:bg-white/[0.08] hover:text-white transition-colors cursor-pointer"
          title="Pause / Resume terminal animation"
          aria-label="Pause or Resume terminal animation"
        >
          <svg id="icon-pause" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="currentColor">
            <rect x="6" y="4" width="4" height="16" rx="1"></rect>
            <rect x="14" y="4" width="4" height="16" rx="1"></rect>
          </svg>
          <svg id="icon-play" class="hidden h-3.5 w-3.5" viewBox="0 0 24 24" fill="currentColor">
            <polygon points="5 3 19 12 5 21 5 3"></polygon>
          </svg>
        </button>

        <!-- Copy Session Output Button -->
        <button
          id="terminal-copy-btn"
          type="button"
          class="inline-flex h-7 w-7 items-center justify-center rounded-md border border-white/[0.06] bg-white/[0.03] hover:bg-white/[0.08] hover:text-white transition-colors cursor-pointer"
          title="Copy session output"
          aria-label="Copy terminal text"
        >
          <svg id="icon-copy" class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
          </svg>
          <svg id="icon-check" class="hidden h-3.5 w-3.5 text-emerald-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="20 6 9 17 4 12"></polyline>
          </svg>
        </button>
      </div>
    </div>

    <!-- Terminal Screen Surface: Compact, balanced height -->
    <div
      id="terminal-screen"
      class="terminal-screen relative h-[270px] sm:h-[295px] lg:h-[315px] p-3.5 sm:p-4 font-mono text-xs sm:text-[13px] leading-relaxed overflow-y-auto overflow-x-auto scroll-smooth no-scrollbar"
    >
      <!-- Session History: Smoothly renders executed commands and formatted outputs -->
      <div id="terminal-history" class="space-y-4"></div>

      <!-- Active Typing Line with Modern Starship-style Prompt -->
      <div id="terminal-active-line" class="mt-3.5 flex items-start gap-2">
        <div class="terminal-prompt flex items-center gap-1.5 shrink-0 select-none">
          <span class="text-emerald-400 font-semibold">~/handbook</span>
          <span class="text-purple-400/90 text-[11px] font-medium flex items-center gap-0.5">
            <span class="text-purple-400">⎇</span><span id="terminal-branch">main</span>
          </span>
          <span class="text-accent font-bold">❯</span>
        </div>
        <div class="flex-1 flex items-center flex-wrap min-w-0">
          <span id="terminal-active-input" class="inline tracking-wide"></span>
          <span class="terminal-cursor ml-1" aria-hidden="true"></span>
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  /* Premium terminal typography and rendering */
  .terminal-window,
  .terminal-screen {
    font-family: 'JetBrains Mono', var(--font-mono);
    font-feature-settings: "calt" 1, "zero" 1;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    letter-spacing: -0.012em;
  }

  /* Ultra-smooth backdrop blur for header */
  .terminal-navbar {
    backdrop-filter: blur(28px) saturate(180%);
    -webkit-backdrop-filter: blur(28px) saturate(180%);
  }

  /* Modern glowing cursor */
  .terminal-cursor {
    display: inline-block;
    width: 0.5rem;
    height: 1.15rem;
    border-radius: 2px;
    background: var(--c-accent, #f2a93c);
    box-shadow: 0 0 10px var(--c-accent, #f2a93c);
    vertical-align: text-bottom;
    animation: terminal-glow 1s cubic-bezier(0.4, 0, 0.6, 1) infinite;
  }

  @keyframes terminal-glow {
    0%, 100% {
      opacity: 1;
      transform: scaleY(1);
    }
    50% {
      opacity: 0.2;
      transform: scaleY(0.92);
    }
  }

  /* Smooth reveal animation for commands and outputs */
  :global(.terminal-command-block) {
    animation: terminal-enter 220ms cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  @keyframes terminal-enter {
    from {
      opacity: 0;
      transform: translateY(5px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Custom subtle scrollbar */
  .no-scrollbar::-webkit-scrollbar {
    width: 5px;
    height: 5px;
  }
  .no-scrollbar::-webkit-scrollbar-thumb {
    background: #1f3028;
    border-radius: 9999px;
  }
  .no-scrollbar::-webkit-scrollbar-thumb:hover {
    background: #2b4539;
  }

  @media (prefers-reduced-motion: reduce) {
    .terminal-cursor {
      animation: none;
      opacity: 0.5;
    }
    :global(.terminal-command-block) {
      animation: none;
    }
  }
</style>

<script>
  interface TerminalCommand {
    cmd: string;
    output: string[];
    outputClass?: string;
  }

  interface TerminalSession {
    id: string;
    name: string;
    branch: string;
    title: string;
    commands: TerminalCommand[];
  }

  const SESSIONS: TerminalSession[] = [
    {
      id: 'k8s',
      name: 'k8s',
      branch: 'main',
      title: 'ops-handbook ~ k8s-cluster',
      commands: [
        {
          cmd: 'kubectl get nodes',
          output: [
            'NAME                   STATUS    ROLES           AGE   VERSION',
            'k8s-control-plane-01   ● Ready   control-plane   42d   v1.30.0',
            'k8s-worker-node-01     ● Ready   worker          42d   v1.30.0',
            'k8s-worker-node-02     ● Ready   worker          42d   v1.30.0',
          ],
          outputClass: 'text-emerald-400/90',
        },
        {
          cmd: 'kubectl get pods -n kube-system',
          output: [
            'NAME                                   READY   STATUS      RESTARTS   AGE',
            'coredns-5dd5756b68-2kxnf               1/1     ● Running   0          42d',
            'etcd-k8s-control-plane-01              1/1     ● Running   0          42d',
            'kube-apiserver-k8s-control-plane-01    1/1     ● Running   0          42d',
          ],
          outputClass: 'text-sky-300/90',
        },
        {
          cmd: 'kubectl get svc --all-namespaces',
          output: [
            'NAMESPACE     NAME         TYPE        CLUSTER-IP   PORT(S)',
            'default       kubernetes   ClusterIP   10.96.0.1    443/TCP',
            'kube-system   kube-dns     ClusterIP   10.96.0.10   53/UDP,53/TCP',
          ],
          outputClass: 'text-amber-400/90',
        },
      ],
    },
    {
      id: 'hub',
      name: 'hub',
      branch: 'docs',
      title: 'ops-handbook ~ knowledge-hub',
      commands: [
        {
          cmd: 'find content/cheat-sheets -mindepth 1 -maxdepth 1 -type d',
          output: [
            'content/cheat-sheets/git         (9 topics · 52 commands)',
            'content/cheat-sheets/github      (7 topics · 38 commands)',
            'content/cheat-sheets/kubernetes  (3 topics · 34 commands)',
          ],
          outputClass: 'text-emerald-400/90',
        },
        {
          cmd: 'find content/interview-questions -mindepth 1 -maxdepth 1 -type d',
          output: [
            'content/interview-questions/kubernetes  (7 topics · 18 Qs)',
            'content/interview-questions/linux       (6 topics · 12 Qs)',
            'content/interview-questions/git         (4 topics ·  8 Qs)',
          ],
          outputClass: 'text-amber-400/90',
        },
        {
          cmd: 'npm run build',
          output: [
            '✓ Synced content collections in 1.1s',
            '✓ Generated 175 static HTML pages',
            '✨ Build finished cleanly in 18.2s',
          ],
          outputClass: 'text-emerald-400 font-semibold',
        },
      ],
    },
    {
      id: 'linux',
      name: 'linux',
      branch: 'prod',
      title: 'ops-handbook ~ linux-runtime',
      commands: [
        {
          cmd: 'docker ps --format "table {{.Names}}\\t{{.Status}}\\t{{.Ports}}"',
          output: [
            'NAMES             STATUS          PORTS',
            'ingress-proxy     Up 4 days       80/tcp, 443/tcp',
            'redis-cache       Up 18 days      6379/tcp',
            'metrics-exporter  Up 18 days      9100/tcp',
          ],
          outputClass: 'text-sky-300/90',
        },
        {
          cmd: 'systemctl is-active docker containerd',
          output: ['● active', '● active'],
          outputClass: 'text-emerald-400 font-semibold',
        },
        {
          cmd: 'free -h',
          output: [
            '              total        used        free      available',
            'Mem:           15Gi       4.2Gi       7.1Gi         10.5Gi',
            'Swap:         4.0Gi          0B       4.0Gi          4.0Gi',
          ],
          outputClass: 'text-amber-400/90',
        },
      ],
    },
    {
      id: 'iac',
      name: 'iac',
      branch: 'infra',
      title: 'ops-handbook ~ terraform-iac',
      commands: [
        {
          cmd: 'terraform validate',
          output: ['Success! The configuration is valid.'],
          outputClass: 'text-emerald-400 font-semibold',
        },
        {
          cmd: 'terraform plan -compact-warnings',
          output: [
            'Terraform will perform the following actions:',
            '  + module.vpc.aws_subnet.private["zone-a"]',
            '  + module.eks.aws_eks_node_group.workers',
            'Plan: 2 to add, 0 to change, 0 to destroy.',
          ],
          outputClass: 'text-amber-400/90',
        },
        {
          cmd: 'terraform show -json tfplan | jq \'.resource_changes | length\'',
          output: ['2'],
          outputClass: 'text-emerald-400 font-semibold',
        },
      ],
    },
  ];

  function escapeHtml(str: string): string {
    return str
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#039;');
  }

  /**
   * Modern syntax highlighter for shell commands
   */
  function highlightCommand(cmd: string): string {
    const tokens = cmd.split(' ');
    return tokens
      .map((token, idx) => {
        if (!token) return '';
        const escaped = escapeHtml(token);

        // Command binary / primary executable
        if (idx === 0 || tokens[idx - 1] === '|' || tokens[idx - 1] === '&&') {
          return `<span class="text-emerald-400 font-bold">${escaped}</span>`;
        }

        // Subcommands (get, plan, validate, show, is-active, ps, run)
        if (
          idx === 1 &&
          !token.startsWith('-') &&
          ['get', 'plan', 'validate', 'show', 'is-active', 'ps', 'run', 'build'].includes(token)
        ) {
          return `<span class="text-sky-300 font-semibold">${escaped}</span>`;
        }

        // Flags / options (-n, --format, -compact-warnings, etc)
        if (token.startsWith('-')) {
          return `<span class="text-amber-300/90 font-medium">${escaped}</span>`;
        }

        // Pipe / operator
        if (['|', '&&', '>', '>>'].includes(token)) {
          return `<span class="text-accent font-bold">${escaped}</span>`;
        }

        // Strings / arguments
        if (token.startsWith('"') || token.startsWith("'")) {
          return `<span class="text-teal-200/90">${escaped}</span>`;
        }

        return `<span class="text-slate-100">${escaped}</span>`;
      })
      .join(' ');
  }

  (function initModernTerminal() {
    const screenEl = document.getElementById('terminal-screen');
    const historyEl = document.getElementById('terminal-history');
    const activeInputEl = document.getElementById('terminal-active-input');
    const branchEl = document.getElementById('terminal-branch');
    const playPauseBtn = document.getElementById('terminal-play-pause-btn');
    const copyBtn = document.getElementById('terminal-copy-btn');
    const iconPause = document.getElementById('icon-pause');
    const iconPlay = document.getElementById('icon-play');
    const iconCopy = document.getElementById('icon-copy');
    const iconCheck = document.getElementById('icon-check');
    const tabButtons = document.querySelectorAll<HTMLButtonElement>('.terminal-tab');

    if (!screenEl || !historyEl || !activeInputEl) return;

    let sessionIdx = 0;
    let cmdIdx = 0;
    let charIdx = 0;
    let activeTimer: number | undefined;
    let isPaused = false;

    const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');

    function updateTabsUI() {
      tabButtons.forEach((btn, idx) => {
        if (idx === sessionIdx) {
          btn.className =
            'terminal-tab px-2.5 py-0.5 rounded-md text-[11px] font-mono transition-all duration-200 bg-accent/25 text-accent-ink dark:text-accent font-bold border border-accent/40 shadow-xs';
        } else {
          btn.className =
            'terminal-tab px-2.5 py-0.5 rounded-md text-[11px] font-mono transition-all duration-200 text-[#8ca397] hover:text-white hover:bg-white/5 border border-transparent cursor-pointer';
        }
      });
    }

    function createCompletedCommandBlock(
      cmd: string,
      branch: string,
      outputLines: string[],
      outputClass?: string
    ): HTMLElement {
      const container = document.createElement('div');
      container.className = 'terminal-command-block space-y-1.5';

      // Command line row
      const cmdRow = document.createElement('div');
      cmdRow.className = 'flex items-center gap-1.5 flex-wrap';

      const prompt = document.createElement('div');
      prompt.className = 'flex items-center gap-1.5 select-none shrink-0';
      prompt.innerHTML = `
        <span class="text-emerald-400 font-semibold">~/handbook</span>
        <span class="text-purple-400/90 text-[11px] font-medium flex items-center gap-0.5">
          <span class="text-purple-400">⎇</span><span>${escapeHtml(branch)}</span>
        </span>
        <span class="text-accent font-bold">❯</span>
      `;

      const cmdText = document.createElement('div');
      cmdText.className = 'tracking-wide';
      cmdText.innerHTML = highlightCommand(cmd);

      cmdRow.append(prompt, cmdText);
      container.append(cmdRow);

      // Formatted Output block
      if (outputLines.length > 0) {
        const outContainer = document.createElement('div');
        outContainer.className = `mt-1 pl-3 border-l-2 border-white/[0.08] space-y-0.5 text-xs ${
          outputClass ?? 'text-[#d6dfd9]'
        }`;

        outputLines.forEach((line) => {
          const lineEl = document.createElement('div');
          // Highlight status indicators smoothly
          if (line.includes('● Ready') || line.includes('● Running') || line.includes('● active')) {
            lineEl.innerHTML = escapeHtml(line).replace(
              /●\s(Ready|Running|active)/g,
              '<span class="text-emerald-400 font-semibold">● $1</span>'
            );
          } else {
            lineEl.textContent = line;
          }
          outContainer.append(lineEl);
        });

        container.append(outContainer);
      }

      return container;
    }

    function smoothScrollToBottom() {
      if (!screenEl) return;
      screenEl.scrollTo({
        top: screenEl.scrollHeight,
        behavior: 'smooth',
      });
    }

    function renderStaticFallback() {
      const session = SESSIONS[sessionIdx];
      if (branchEl) branchEl.textContent = session.branch;
      updateTabsUI();
      historyEl!.replaceChildren();
      session.commands.forEach((item) => {
        const block = createCompletedCommandBlock(item.cmd, session.branch, item.output, item.outputClass);
        historyEl!.append(block);
      });
      activeInputEl!.innerHTML = '';
    }

    if (motionQuery.matches) {
      renderStaticFallback();
      return;
    }

    function switchSession(idx: number) {
      if (activeTimer) window.clearTimeout(activeTimer);
      sessionIdx = idx;
      cmdIdx = 0;
      charIdx = 0;
      updateTabsUI();
      const currentSession = SESSIONS[sessionIdx];
      if (branchEl) branchEl.textContent = currentSession.branch;

      historyEl!.style.opacity = '0';
      historyEl!.style.transition = 'opacity 180ms ease';

      activeTimer = window.setTimeout(() => {
        historyEl!.replaceChildren();
        activeInputEl!.innerHTML = '';
        historyEl!.style.opacity = '1';
        historyEl!.style.transition = '';
        smoothScrollToBottom();

        if (!isPaused) {
          activeTimer = window.setTimeout(step, 300);
        }
      }, 180);
    }

    // Tab buttons click listener
    tabButtons.forEach((btn, idx) => {
      btn.addEventListener('click', () => {
        switchSession(idx);
      });
    });

    // Play/Pause button listener
    if (playPauseBtn && iconPause && iconPlay) {
      playPauseBtn.addEventListener('click', () => {
        isPaused = !isPaused;
        if (isPaused) {
          iconPause.classList.add('hidden');
          iconPlay.classList.remove('hidden');
          if (activeTimer) window.clearTimeout(activeTimer);
        } else {
          iconPlay.classList.add('hidden');
          iconPause.classList.remove('hidden');
          step();
        }
      });
    }

    // Copy button listener
    if (copyBtn && iconCopy && iconCheck) {
      copyBtn.addEventListener('click', async () => {
        const currentSession = SESSIONS[sessionIdx];
        const lines: string[] = [];
        currentSession.commands.forEach((c) => {
          lines.push(`$ ${c.cmd}`);
          lines.push(...c.output);
        });

        try {
          await navigator.clipboard.writeText(lines.join('\n'));
          iconCopy.classList.add('hidden');
          iconCheck.classList.remove('hidden');
          setTimeout(() => {
            iconCheck.classList.add('hidden');
            iconCopy.classList.remove('hidden');
          }, 1800);
        } catch {
          // fallback ignore
        }
      });
    }

    function step() {
      if (isPaused) return;

      const currentSession = SESSIONS[sessionIdx];
      updateTabsUI();
      if (branchEl) branchEl.textContent = currentSession.branch;

      const currentCommand = currentSession.commands[cmdIdx];

      // Typing phase: natural human-like variation
      if (charIdx < currentCommand.cmd.length) {
        charIdx++;
        const currentSlice = currentCommand.cmd.slice(0, charIdx);
        activeInputEl!.innerHTML = highlightCommand(currentSlice);
        smoothScrollToBottom();

        // Cadence with micro-pause at spaces or symbols for realistic smoothness
        const char = currentCommand.cmd[charIdx - 1];
        const delay = char === ' ' ? 65 : char === '-' ? 50 : 26 + Math.floor(Math.random() * 14);

        activeTimer = window.setTimeout(step, delay);
        return;
      }

      // Command typed: brief pause before execution
      activeTimer = window.setTimeout(() => {
        if (isPaused) return;

        // Render completed block with slide-in animation
        const block = createCompletedCommandBlock(
          currentCommand.cmd,
          currentSession.branch,
          currentCommand.output,
          currentCommand.outputClass
        );
        historyEl!.append(block);

        // Reset active line
        charIdx = 0;
        activeInputEl!.innerHTML = '';
        smoothScrollToBottom();

        cmdIdx++;

        if (cmdIdx < currentSession.commands.length) {
          // Pause between commands in the same session
          activeTimer = window.setTimeout(step, 420);
        } else {
          // Session completed: hold for reading, then smoothly transition to next
          activeTimer = window.setTimeout(() => {
            if (isPaused) return;

            historyEl!.style.opacity = '0';
            historyEl!.style.transition = 'opacity 250ms ease';

            activeTimer = window.setTimeout(() => {
              historyEl!.replaceChildren();
              historyEl!.style.opacity = '1';
              historyEl!.style.transition = '';

              cmdIdx = 0;
              charIdx = 0;
              sessionIdx = (sessionIdx + 1) % SESSIONS.length;
              smoothScrollToBottom();

              activeTimer = window.setTimeout(step, 400);
            }, 250);
          }, 3800);
        }
      }, 280);
    }

    // Launch animation
    activeTimer = window.setTimeout(step, 350);

    window.addEventListener(
      'pagehide',
      () => {
        if (activeTimer) window.clearTimeout(activeTimer);
      },
      { once: true }
    );
  })();
</script>
